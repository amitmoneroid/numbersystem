---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';
---

<Layout>
  <Navbar />

  <main>
    <!-- ═══════════════ CONVERTER (TOP OF PAGE) ═══════════════ -->
    <section class="converter-hero mesh-gradient" id="converter">
      <div class="page-container converter-container">

        <!-- Converter Card -->
        <div class="converter-card card shadow-level-3">
          <!-- Title inside card -->
          <div class="converter-header">
            <h1 class="converter-title">Number System Converter</h1>
            <p class="converter-lead">Convert between Indian & International number systems</p>
          </div>

          <!-- Row 1: Amount + From Unit -->
          <div class="converter-input-row">
            <div class="field-group field-amount">
              <label for="numInput" class="body-sm-strong field-label">Amount</label>
              <input
                type="text"
                id="numInput"
                class="converter-input"
                placeholder="e.g. 5.4"
                inputmode="decimal"
                autocomplete="off"
              />
            </div>
            <div class="field-group field-scale">
              <label for="fromScale" class="body-sm-strong field-label">From</label>
              <select id="fromScale" class="scale-select">
                <optgroup label="International System">
                  <option value="1e3">Thousand</option>
                  <option value="1e6">Million</option>
                  <option value="1e9" selected>Billion</option>
                  <option value="1e12">Trillion</option>
                  <option value="1e15">Quadrillion</option>
                  <option value="1e18">Quintillion</option>
                </optgroup>
                <optgroup label="Indian System">
                  <option value="1e5">Lakh</option>
                  <option value="1e7">Crore</option>
                  <option value="1e9">Arab</option>
                  <option value="1e11">Kharab</option>
                  <option value="1e13">Neel</option>
                  <option value="1e15">Padma</option>
                  <option value="1e17">Shankh</option>
                </optgroup>
              </select>
            </div>
          </div>

          <!-- Row 2: To Unit -->
          <div class="converter-input-row">
            <div class="field-group field-amount" style="flex: 0 0 auto; width: auto; min-width: 140px;">
              <label class="body-sm-strong field-label" style="visibility: hidden; height: 0; margin: 0; padding: 0;">&nbsp;</label>
              <span class="converter-arrow" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </div>
            <div class="field-group field-scale">
              <label for="toScale" class="body-sm-strong field-label">To</label>
              <select id="toScale" class="scale-select">
                <optgroup label="Indian System">
                  <option value="1e5">Lakh</option>
                  <option value="1e7">Crore</option>
                  <option value="1e9" selected>Arab</option>
                  <option value="1e11">Kharab</option>
                  <option value="1e13">Neel</option>
                  <option value="1e15">Padma</option>
                  <option value="1e17">Shankh</option>
                </optgroup>
                <optgroup label="International System">
                  <option value="1e3">Thousand</option>
                  <option value="1e6">Million</option>
                  <option value="1e9">Billion</option>
                  <option value="1e12">Trillion</option>
                  <option value="1e15">Quadrillion</option>
                  <option value="1e18">Quintillion</option>
                </optgroup>
              </select>
            </div>
          </div>

          <div id="inputError" class="input-error"></div>

          <!-- Converted Value Display -->
          <div id="convertedValueArea" class="converted-value-area hidden">
            <div class="converted-value-label">Converted Value</div>
            <div id="convertedValue" class="converted-value code">—</div>
            <div id="convertedSubtitle" class="converted-subtitle body-sm">—</div>
          </div>

          <!-- Quick Example Chips -->
          <div class="chips-row">
            <span class="chips-label">Try:</span>
            <div class="chips">
              <button class="chip" data-value="1" data-from="1e3">1 Thousand</button>
              <button class="chip" data-value="1" data-from="1e5">1 Lakh</button>
              <button class="chip" data-value="1" data-from="1e6">1 Million</button>
              <button class="chip" data-value="1" data-from="1e7">1 Crore</button>
              <button class="chip" data-value="5.4" data-from="1e9">5.4 Billion</button>
              <button class="chip" data-value="1" data-from="1e12">1 Trillion</button>
              <button class="chip" data-value="1" data-from="1e17">1 Shankh</button>
            </div>
          </div>

          <!-- ═══════ RESULTS ═══════ -->
          <div id="resultsArea" class="results-area hidden">
            <!-- Separator -->
            <div class="results-divider"></div>

            <!-- Best Fit Highlight -->
            <div id="bestFitCard" class="best-fit-card">
              <div class="best-fit-value code" id="bestFitValue">—</div>
              <div class="best-fit-subtitle body-sm" id="bestFitSubtitle">—</div>
            </div>

            <!-- All Representations Table -->
            <div class="representations-section">
              <h3 class="representations-title body-sm-strong" id="representationsTitle">—</h3>
              <div class="representations-grid" id="representationsGrid">
              </div>
            </div>

            <!-- Full Number Display -->
            <div class="full-number-section">
              <div class="number-format-group">
                <div class="number-format-row">
                  <span class="number-format-label">International</span>
                  <span class="number-format-value code" id="fullIntlNumber">—</span>
                  <button class="copy-btn" data-target="fullIntlNumber" title="Copy" aria-label="Copy international formatted number">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                  </button>
                </div>
                <div class="number-words body-sm" id="intlWords">—</div>
              </div>
              <div class="number-format-group">
                <div class="number-format-row">
                  <span class="number-format-label">Indian</span>
                  <span class="number-format-value code" id="fullIndNumber">—</span>
                  <button class="copy-btn" data-target="fullIndNumber" title="Copy" aria-label="Copy Indian formatted number">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                  </button>
                </div>
                <div class="number-words body-sm" id="indWords">—</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ═══════════════ HOW IT WORKS ═══════════════ -->
    <section id="how-it-works" class="band-canvas section-band">
      <div class="page-container">
        <div class="section-header">
          <span class="eyebrow">How It Works</span>
          <h2 class="display-lg">Two systems, same numbers, different grouping.</h2>
          <p class="body-md" style="color: var(--color-body); max-width: 640px;">
            The International and Indian number systems represent the same values but use different grouping conventions and names for large numbers.
          </p>
        </div>

        <div class="features-grid">
          <!-- Feature 1 -->
          <div class="feature-card card shadow-level-3">
            <div class="feature-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
            </div>
            <h3 class="display-sm">Multiples of Thousands</h3>
            <p class="body-sm" style="color: var(--color-body);">
              The International system groups digits in sets of three from the right. Each new name represents a thousand times the previous: <strong>Thousand</strong> (10&sup3;), <strong>Million</strong> (10&sup6;), <strong>Billion</strong> (10&sup9;), <strong>Trillion</strong> (10&sup1;&sup2;).
            </p>
            <div class="feature-example code">
              1,000,000,000 &rarr; One Billion
            </div>
          </div>

          <!-- Feature 2 -->
          <div class="feature-card card shadow-level-3">
            <div class="feature-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <h3 class="display-sm">Multiples of Hundreds</h3>
            <p class="body-sm" style="color: var(--color-body);">
              The Indian system groups the first three digits from the right, then every two digits after that. Each new name represents a hundred times the previous: <strong>Lakh</strong> (10&sup5;), <strong>Crore</strong> (10&sup7;), <strong>Arab</strong> (10&sup9;), <strong>Shankh</strong> (10&sup1;&sup7;).
            </p>
            <div class="feature-example code">
              1,00,00,00,000 &rarr; One Arab
            </div>
          </div>

          <!-- Feature 3 -->
          <div class="feature-card card shadow-level-3">
            <div class="feature-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="M21 3l-7 7"/><path d="M8 21H3v-5"/><path d="M3 21l7-7"/></svg>
            </div>
            <h3 class="display-sm">Same Value, Different Names</h3>
            <p class="body-sm" style="color: var(--color-body);">
              The same numeric value has different labels and comma placement in each system. <strong>1 Million = 10 Lakh</strong>. <strong>1 Billion = 1 Arab</strong>. Understanding both helps avoid costly mistakes in cross-cultural finance and communication.
            </p>
            <div class="feature-example code">
              1 Million = 10,00,000 = 10 Lakh
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════ REFERENCE TABLE — DARK BAND ═══════════════ -->
    <section id="reference" class="band-ink section-band">
      <div class="page-container">
        <div class="section-header section-header-dark">
          <span class="eyebrow" style="color: rgba(255,255,255,0.5);">Reference</span>
          <h2 class="display-lg" style="color: #fff;">Side-by-side comparison of both systems.</h2>
          <p class="body-md" style="color: rgba(255,255,255,0.65); max-width: 640px;">
            A complete mapping of how each scale is named, formatted, and pronounced in the International versus Indian number system.
          </p>
        </div>

        <div class="ref-table-card">
          <table class="reference-table">
            <thead>
              <tr>
                <th>Value</th>
                <th>International Name</th>
                <th>Intl Format</th>
                <th>Indian Name</th>
                <th>Indian Format</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="scale-name">10&sup3;</td>
                <td>Thousand</td>
                <td class="num-intl">1,000</td>
                <td>&mdash;</td>
                <td class="num-indian">1,000</td>
              </tr>
              <tr>
                <td class="scale-name">10&sup5;</td>
                <td>Hundred Thousand</td>
                <td class="num-intl">100,000</td>
                <td>Lakh</td>
                <td class="num-indian">1,00,000</td>
              </tr>
              <tr>
                <td class="scale-name">10&sup6;</td>
                <td>Million</td>
                <td class="num-intl">1,000,000</td>
                <td>Ten Lakh</td>
                <td class="num-indian">10,00,000</td>
              </tr>
              <tr>
                <td class="scale-name">10&sup7;</td>
                <td>Ten Million</td>
                <td class="num-intl">10,000,000</td>
                <td>Crore</td>
                <td class="num-indian">1,00,00,000</td>
              </tr>
              <tr>
                <td class="scale-name">10&sup8;</td>
                <td>Hundred Million</td>
                <td class="num-intl">100,000,000</td>
                <td>Ten Crore</td>
                <td class="num-indian">10,00,00,000</td>
              </tr>
              <tr>
                <td class="scale-name">10&sup9;</td>
                <td>Billion</td>
                <td class="num-intl">1,000,000,000</td>
                <td>Arab</td>
                <td class="num-indian">1,00,00,00,000</td>
              </tr>
              <tr>
                <td class="scale-name">10&sup1;&sup1;</td>
                <td>Hundred Billion</td>
                <td class="num-intl">100,000,000,000</td>
                <td>Kharab</td>
                <td class="num-indian">1,00,00,00,00,000</td>
              </tr>
              <tr>
                <td class="scale-name">10&sup1;&sup3;</td>
                <td>Ten Trillion</td>
                <td class="num-intl">10,000,000,000,000</td>
                <td>Neel</td>
                <td class="num-indian">1,00,00,00,00,00,000</td>
              </tr>
              <tr>
                <td class="scale-name">10&sup1;&sup5;</td>
                <td>Quadrillion</td>
                <td class="num-intl">1,000,000,000,000,000</td>
                <td>Padma</td>
                <td class="num-indian">1,00,00,00,00,00,00,000</td>
              </tr>
              <tr>
                <td class="scale-name">10&sup1;&sup7;</td>
                <td>Hundred Quadrillion</td>
                <td class="num-intl">100,000,000,000,000,000</td>
                <td>Shankh</td>
                <td class="num-indian">1,00,00,00,00,00,00,00,000</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <FAQ />
  <Footer />
</Layout>

<!-- ═══════════════ CONVERSION LOGIC ═══════════════ -->
<script>
  // ── DOM Elements ──
  const numInput = document.getElementById('numInput') as HTMLInputElement;
  const fromScale = document.getElementById('fromScale') as HTMLSelectElement;
  const toScale = document.getElementById('toScale') as HTMLSelectElement;
  const inputError = document.getElementById('inputError') as HTMLDivElement;
  const resultsArea = document.getElementById('resultsArea') as HTMLDivElement;
  const convertedValueArea = document.getElementById('convertedValueArea') as HTMLDivElement;
  const convertedValue = document.getElementById('convertedValue') as HTMLDivElement;
  const convertedSubtitle = document.getElementById('convertedSubtitle') as HTMLDivElement;

  // Results
  const bestFitValue = document.getElementById('bestFitValue') as HTMLDivElement;
  const bestFitSubtitle = document.getElementById('bestFitSubtitle') as HTMLDivElement;
  const representationsTitle = document.getElementById('representationsTitle') as HTMLHeadingElement;
  const representationsGrid = document.getElementById('representationsGrid') as HTMLDivElement;
  const fullIntlNumber = document.getElementById('fullIntlNumber') as HTMLDivElement;
  const fullIndNumber = document.getElementById('fullIndNumber') as HTMLDivElement;
  const intlWords = document.getElementById('intlWords') as HTMLDivElement;
  const indWords = document.getElementById('indWords') as HTMLDivElement;

  // ── State ──
  // No longer need targetSystem state since we have explicit "To" dropdown

  // ── Scale Data ──
  const intlScales = [
    { multiplier: 1e18, name: 'Quintillion' },
    { multiplier: 1e15, name: 'Quadrillion' },
    { multiplier: 1e12, name: 'Trillion' },
    { multiplier: 1e9,  name: 'Billion' },
    { multiplier: 1e6,  name: 'Million' },
    { multiplier: 1e3,  name: 'Thousand' },
  ];

  const indScales = [
    { multiplier: 1e17, name: 'Shankh' },
    { multiplier: 1e15, name: 'Padma' },
    { multiplier: 1e13, name: 'Neel' },
    { multiplier: 1e11, name: 'Kharab' },
    { multiplier: 1e9,  name: 'Arab' },
    { multiplier: 1e7,  name: 'Crore' },
    { multiplier: 1e5,  name: 'Lakh' },
  ];

  // Map from select value to system type
  const internationalMultipliers = [1e3, 1e6, 1e9, 1e12, 1e15, 1e18];
  const indianMultipliers = [1e5, 1e7, 1e9, 1e11, 1e13, 1e15, 1e17];

  function getFromSystem(multiplier: number): 'intl' | 'ind' {
    // Indian-exclusive multipliers (not shared with International)
    if ([1e5, 1e7, 1e11, 1e13, 1e17].includes(multiplier)) return 'ind';
    // International-exclusive multipliers (not shared with Indian)
    if ([1e3, 1e6, 1e12, 1e18].includes(multiplier)) return 'intl';
    // Shared: 1e9 and 1e15 — use the optgroup label from select
    // Since we can't easily get the optgroup, default: these are ambiguous,
    // but practically "Billion" is Intl, "Arab" is Ind.
    // The select has them in both optgroups with same value.
    // Default to intl for 1e9 and 1e15 if we can't determine.
    return 'intl';
  }

  // ── Number Words Helpers ──
  const ones = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',
    'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
  const tensWords = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

  function convertUnder100(n: number): string {
    if (n < 20) return ones[n];
    const t = Math.floor(n / 10);
    const u = n % 10;
    return tensWords[t] + (u ? ' ' + ones[u] : '');
  }

  function convertUnder1000(n: number): string {
    if (n < 100) return convertUnder100(n);
    const h = Math.floor(n / 100);
    const r = n % 100;
    return ones[h] + ' Hundred' + (r ? ' ' + convertUnder100(r) : '');
  }

  // ── International Number to Words ──
  function numberToWordsInternational(num: number): string {
    if (num === 0) return 'Zero';
    const scales = [
      { value: 1e18, name: 'Quintillion' },
      { value: 1e15, name: 'Quadrillion' },
      { value: 1e12, name: 'Trillion' },
      { value: 1e9,  name: 'Billion' },
      { value: 1e6,  name: 'Million' },
      { value: 1e3,  name: 'Thousand' },
    ];
    let n = Math.floor(num);
    let result = '';
    for (const scale of scales) {
      if (n >= scale.value) {
        const chunk = Math.floor(n / scale.value);
        n = n % scale.value;
        result += convertUnder1000(chunk) + ' ' + scale.name;
        if (n > 0) result += ' ';
      }
    }
    if (n > 0) {
      result += convertUnder1000(n);
    }
    return result.trim();
  }

  // ── Indian Number to Words ──
  function numberToWordsIndian(num: number): string {
    if (num === 0) return 'Zero';
    const scales = [
      { value: 1e17, name: 'Shankh' },
      { value: 1e15, name: 'Padma' },
      { value: 1e13, name: 'Neel' },
      { value: 1e11, name: 'Kharab' },
      { value: 1e9,  name: 'Arab' },
      { value: 1e7,  name: 'Crore' },
      { value: 1e5,  name: 'Lakh' },
    ];
    let n = Math.floor(num);
    let result = '';
    for (const scale of scales) {
      if (n >= scale.value) {
        const chunk = Math.floor(n / scale.value);
        n = n % scale.value;
        result += convertUnder100(chunk) + ' ' + scale.name;
        if (n > 0) result += ' ';
      }
    }
    if (n >= 1000) {
      const chunk = Math.floor(n / 1000);
      n = n % 1000;
      result += convertUnder100(chunk) + ' Thousand';
      if (n > 0) result += ' ';
    }
    if (n > 0) {
      result += convertUnder1000(n);
    }
    return result.trim();
  }

  // ── Number Formatting ──
  function formatInternational(num: number): string {
    if (num === 0) return '0';
    const str = Math.floor(num).toString();
    let result = '';
    let count = 0;
    for (let i = str.length - 1; i >= 0; i--) {
      if (count > 0 && count % 3 === 0) result = ',' + result;
      result = str[i] + result;
      count++;
    }
    return result;
  }

  function formatIndian(num: number): string {
    if (num === 0) return '0';
    const str = Math.floor(num).toString();
    if (str.length <= 3) return str;

    let result = str.slice(-3);
    let remaining = str.slice(0, -3);

    while (remaining.length > 2) {
      result = remaining.slice(-2) + ',' + result;
      remaining = remaining.slice(0, -2);
    }

    if (remaining.length > 0) {
      result = remaining + ',' + result;
    }

    return result;
  }

  // ── Format a value for display in a scale (handles decimals nicely) ──
  function formatScaledValue(value: number): string {
    if (value === 0) return '0';

    const absVal = Math.abs(value);

    if (absVal >= 1) {
      // Integer or mixed number
      if (Number.isInteger(value)) {
        return value.toLocaleString('en-IN', { maximumFractionDigits: 0 });
      }
      // Decimal — show up to 4 decimal places, strip trailing zeros
      const fixed = value.toFixed(4);
      const stripped = parseFloat(fixed).toString();
      // Add commas to the integer part
      const parts = stripped.split('.');
      const intPart = parseInt(parts[0]).toLocaleString('en-IN', { maximumFractionDigits: 0 });
      return parts.length > 1 ? `${intPart}.${parts[1]}` : intPart;
    }

    // Very small numbers — show up to 6 significant digits
    const formatted = value.toPrecision(6);
    // Strip trailing zeros after decimal
    return parseFloat(formatted).toString();
  }

  // ── Parse Input ──
  function parseInput(): { rawValue: number; integerPart: number; amount: number; fromMultiplier: number } | null {
    const raw = numInput.value.replace(/[,，\s]/g, '');
    if (raw === '') return null;

    const amount = parseFloat(raw);
    if (isNaN(amount) || amount < 0) {
      inputError.textContent = 'Please enter a valid positive number.';
      inputError.classList.add('visible');
      return null;
    }

    const fromMultiplier = parseFloat(fromScale.value);
    const rawValue = amount * fromMultiplier;

    if (rawValue > 1e20) {
      inputError.textContent = 'Number too large. Please enter a smaller value.';
      inputError.classList.add('visible');
      return null;
    }

    inputError.textContent = '';
    inputError.classList.remove('visible');

    return {
      rawValue,
      integerPart: Math.floor(rawValue),
      amount,
      fromMultiplier,
    };
  }

  // ── Find the best-fit scale ──
  function findBestFit(rawValue: number, scales: { multiplier: number; name: string }[]): { value: number; name: string } | null {
    // Best fit = smallest scale where value >= 1
    let best: { value: number; name: string } | null = null;
    for (const scale of scales) {
      const val = rawValue / scale.multiplier;
      if (val >= 1) {
        best = { value: val, name: scale.name };
        // Don't break — keep going to find the smallest scale with value >= 1
      }
    }
    return best;
  }

  // ── Show All Representations ──
  function showAllRepresentations(rawValue: number): void {
    // Determine target system from the "To" scale
    const toMult = parseFloat(toScale.value);
    const isTargetIndian = indianMultipliers.includes(toMult);
    const scales = isTargetIndian ? indScales : intlScales;
    const systemLabel = isTargetIndian ? 'Indian' : 'International';

    // Title
    representationsTitle.textContent = `All ${systemLabel} Representations`;

    // Build grid
    representationsGrid.innerHTML = '';

    // Find best fit for highlighting
    const bestFit = findBestFit(rawValue, scales.slice().reverse()); // reverse for ascending order

    for (const scale of scales) {
      const value = rawValue / scale.multiplier;
      const isBestFit = bestFit && bestFit.name === scale.name;

      const item = document.createElement('div');
      item.className = `representation-item${isBestFit ? ' best-fit' : ''}`;
      item.innerHTML = `
        <span class="rep-scale-name${isBestFit ? ' best-fit-name' : ''}">${scale.name}</span>
        <span class="rep-scale-value${isBestFit ? ' best-fit-value' : ''}">${formatScaledValue(value)}</span>
      `;
      representationsGrid.appendChild(item);
    }

    // Best fit highlight card
    if (bestFit) {
      const fromName = getFromScaleName();
      const bestFitFormatted = formatScaledValue(bestFit.value);
      bestFitValue.textContent = `${bestFitFormatted} ${bestFit.name}`;
      bestFitSubtitle.textContent = `${numInput.value} ${fromName} = ${bestFitFormatted} ${bestFit.name}`;
      bestFitCard.classList.remove('hidden');
    } else {
      bestFitCard.classList.add('hidden');
    }
  }

  // ── Get the "From" scale display name ──
  function getFromScaleName(): string {
    const val = parseFloat(fromScale.value);
    // Check in International scales first
    const intlMatch = intlScales.find(s => s.multiplier === val);
    // Check in Indian scales
    const indMatch = indScales.find(s => s.multiplier === val);

    // For shared multipliers (1e9, 1e15), try to determine from optgroup
    // We'll look at the selected option's parent optgroup
    const selectedOption = fromScale.options[fromScale.selectedIndex];
    const optgroup = selectedOption?.parentElement;
    const label = optgroup?.getAttribute('label') ?? '';

    if (label.includes('Indian')) {
      return indMatch?.name ?? intlMatch?.name ?? '';
    }
    return intlMatch?.name ?? indMatch?.name ?? '';
  }

  // ── Convert ──
  function convert(): void {
    const parsed = parseInput();
    if (!parsed) {
      if (numInput.value.replace(/[,，\s]/g, '') === '') {
        resultsArea.classList.add('hidden');
        convertedValueArea.classList.add('hidden');
      }
      return;
    }

    const { rawValue, integerPart } = parsed;
    resultsArea.classList.remove('hidden');
    convertedValueArea.classList.remove('hidden');

    // Show all representations
    showAllRepresentations(rawValue);

    // Calculate and show converted value
    const toMultiplier = parseFloat(toScale.value);
    const converted = rawValue / toMultiplier;
    const toScaleName = getToScaleName();
    const fromName = getFromScaleName();

    convertedValue.textContent = formatScaledValue(converted);
    convertedSubtitle.textContent = `${numInput.value} ${fromName} = ${formatScaledValue(converted)} ${toScaleName}`;

    // Full number formats
    fullIntlNumber.textContent = formatInternational(integerPart);
    fullIndNumber.textContent = formatIndian(integerPart);

    // Words
    intlWords.textContent = numberToWordsInternational(integerPart);
    indWords.textContent = numberToWordsIndian(integerPart);

    // Animate
    resultsArea.style.animation = 'none';
    resultsArea.offsetHeight;
    resultsArea.style.animation = 'fadeInUp 0.4s ease';
  }

  // ── Get the "To" scale display name ──
  function getToScaleName(): string {
    const val = parseFloat(toScale.value);
    const intlMatch = intlScales.find(s => s.multiplier === val);
    const indMatch = indScales.find(s => s.multiplier === val);

    const selectedOption = toScale.options[toScale.selectedIndex];
    const optgroup = selectedOption?.parentElement;
    const label = optgroup?.getAttribute('label') ?? '';

    if (label.includes('Indian')) {
      return indMatch?.name ?? intlMatch?.name ?? '';
    }
    return intlMatch?.name ?? indMatch?.name ?? '';
  }

  // ── To Scale Change ──
  toScale.addEventListener('change', () => {
    convert();
  });

  // ── Copy to Clipboard ──
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const targetId = (btn as HTMLButtonElement).dataset.target;
      if (!targetId) return;
      const targetEl = document.getElementById(targetId);
      if (!targetEl) return;

      const text = targetEl.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1200);
      } catch {
        const range = document.createRange();
        range.selectNodeContents(targetEl);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    });
  });

  // ── Event Listeners ──
  numInput.addEventListener('input', convert);

  // Quick example chips
  document.querySelectorAll('.chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const val = (chip as HTMLButtonElement).dataset.value;
      const from = (chip as HTMLButtonElement).dataset.from;
      if (val !== undefined) {
        numInput.value = val;
      }
      if (from !== undefined) {
        fromScale.value = from;

        // Auto-set "To" scale based on "From" scale
        // If "From" is International, default "To" to Indian; vice versa
        const fromMult = parseFloat(from);
        const isIntlScale = internationalMultipliers.includes(fromMult);
        if (isIntlScale) {
          toScale.value = '1e9'; // Arab (Indian)
        } else {
          toScale.value = '1e9'; // Billion (International)
        }
      }
      convert();
    });
  });

  // Handle Enter key
  numInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      convert();
    }
  });
</script>

