---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Contact Us – Number System Converter';
const pageDescription = 'Get in touch with the Number System Converter team. Report bugs, suggest features, or ask questions about converting between Indian and International number systems.';
const pageCanonical = 'https://numbersystemconverter.com/contact';
const pageKeywords = 'contact number system converter, feedback, bug report, feature request, number conversion help';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={pageCanonical}
  keywords={pageKeywords}
>
  <!-- Schema.org Structured Data: ContactPage -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "name": "Contact Number System Converter",
      "url": pageCanonical,
      "description": pageDescription,
      "mainEntity": {
        "@type": "Organization",
        "name": "Number System Converter",
        "url": "https://numbersystemconverter.com",
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "availableLanguage": ["English"]
        }
      }
    })} />
  </Fragment>

  <Navbar />

  <main>
    <!-- ═══════════════ HERO BAND ═══════════════ -->
    <section class="hero-band mesh-gradient">
      <div class="page-container hero-content">
        <span class="eyebrow hero-eyebrow">Get in Touch</span>
        <h1 class="display-xl hero-headline">Contact Us.</h1>
        <p class="body-lg hero-lead">
          Have a question, suggestion, or found a bug? We'd love to hear from you. Choose the best way to reach us below.
        </p>
      </div>
    </section>

    <!-- ═══════════════ CONTACT CARDS ═══════════════ -->
    <section class="band-canvas section-band">
      <div class="page-container">
        <div class="contact-grid">

          <!-- Email Card -->
          <div class="contact-card card shadow-level-3">
            <div class="contact-icon-wrap contact-icon-email">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <h3 class="display-sm">Email Us</h3>
            <p class="body-sm" style="color: var(--color-body);">
              For general inquiries, questions about the converter, or partnership opportunities, drop us an email. We aim to respond within 48 hours.
            </p>
            <a href="mailto:hello@numbersystemconverter.com" class="contact-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              hello@numbersystemconverter.com
            </a>
          </div>

          <!-- Feedback Card -->
          <div class="contact-card card shadow-level-3">
            <div class="contact-icon-wrap contact-icon-feedback">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h3 class="display-sm">Send Feedback</h3>
            <p class="body-sm" style="color: var(--color-body);">
              Found a conversion error? Have an idea for a new feature? Want to suggest additional number systems or languages? We appreciate all feedback.
            </p>
            <a href="mailto:feedback@numbersystemconverter.com?subject=Feedback%20on%20Number%20System%20Converter" class="contact-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              feedback@numbersystemconverter.com
            </a>
          </div>

          <!-- Bug Report Card -->
          <div class="contact-card card shadow-level-3">
            <div class="contact-icon-wrap contact-icon-bug">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </div>
            <h3 class="display-sm">Report a Bug</h3>
            <p class="body-sm" style="color: var(--color-body);">
              If something isn't working as expected — a wrong conversion, a broken layout, or any unexpected behavior — let us know so we can fix it.
            </p>
            <a href="mailto:bugs@numbersystemconverter.com?subject=Bug%20Report%3A%20Number%20System%20Converter" class="contact-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              bugs@numbersystemconverter.com
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════ FAQ TEASER ═══════════════ -->
    <section class="band-canvas-soft section-band">
      <div class="page-container">
        <div class="faq-teaser">
          <h2 class="display-lg" style="color: var(--color-ink);">Have a question?</h2>
          <p class="body-md" style="color: var(--color-body); max-width: 520px;">
            Before reaching out, check our FAQ — we may have already answered your question about number systems, conversions, and how the tool works.
          </p>
          <a href="/#faq" class="btn btn-primary">View FAQ</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ════════════ HERO ════════════ */
  .hero-band {
    padding: var(--spacing-section) var(--spacing-lg) var(--spacing-6xl);
    text-align: center;
    position: relative;
    overflow: hidden;
    background-color: var(--color-canvas-soft);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-lg);
    max-width: 800px;
    margin-inline: auto;
  }

  .hero-eyebrow {
    color: var(--color-violet);
    margin-bottom: 0;
  }

  .hero-headline {
    color: var(--color-ink);
  }

  .hero-lead {
    color: var(--color-body);
    max-width: 620px;
  }

  /* ════════════ SECTION BAND ════════════ */
  .section-band {
    padding: var(--spacing-5xl) var(--spacing-lg);
  }

  /* ════════════ CONTACT GRID ════════════ */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--spacing-lg);
  }

  .contact-card {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
  }

  .contact-card h3 {
    color: var(--color-ink);
    margin-bottom: var(--spacing-sm);
  }

  .contact-icon-wrap {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-md);
  }

  .contact-icon-email {
    background: var(--color-link-bg-soft);
    color: var(--color-link);
  }

  .contact-icon-feedback {
    background: var(--color-violet-soft);
    color: var(--color-violet);
  }

  .contact-icon-bug {
    background: var(--color-warning-soft);
    color: var(--color-warning);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: var(--spacing-md);
    color: var(--color-link);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 400;
    text-decoration: none;
    border-top: 1px solid var(--color-hairline);
    transition: color 0.15s ease;
    word-break: break-all;
  }

  .contact-link:hover {
    color: var(--color-link-deep);
  }

  .dark .contact-icon-feedback {
    background: var(--color-violet-soft);
    color: var(--color-violet);
  }

  .dark .contact-icon-bug {
    background: var(--color-warning-soft);
    color: var(--color-warning);
  }

  /* ════════════ FAQ TEASER ════════════ */
  .faq-teaser {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-sm);
  }

  /* ════════════ BUTTONS ════════════ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all 0.15s ease;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: var(--color-ink);
    color: var(--color-on-primary);
    font-size: 16px;
    line-height: 24px;
    padding: 12px 24px;
  }

  .btn-primary:hover {
    background: #000;
    color: #fff;
  }

  .dark .btn-primary {
    background: #ededed;
    color: #0a0a0a;
  }

  .dark .btn-primary:hover {
    background: #fff;
    color: #000;
  }

  /* ════════════ RESPONSIVE ════════════ */
  @media (max-width: 959px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero-band {
      padding: 96px var(--spacing-md) 64px;
    }

    .section-band {
      padding: var(--spacing-4xl) var(--spacing-md);
    }

    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
