---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'About – Number System Converter | Free Online Tool';
const pageDescription = 'Learn about the Number System Converter — a free, client-side tool that instantly converts numbers between Indian (Lakh, Crore) and International (Million, Billion) number systems with full word expansion.';
const pageCanonical = 'https://numbersystemconverter.com/about/';
const pageKeywords = 'about number system converter, indian international number system, number conversion tool, lakh to million converter';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={pageCanonical}
  keywords={pageKeywords}
>
  <Navbar />

  <main>
    <!-- ═══════════════ HERO BAND ═══════════════ -->
    <section class="hero-band mesh-gradient">
      <div class="page-container hero-content">
        <span class="eyebrow hero-eyebrow">About Us</span>
        <h1 class="display-xl hero-headline">
          A clear, fast number system converter built for everyone.
        </h1>
        <p class="body-lg hero-lead">
          The Number System Converter bridges the gap between Indian and International number naming conventions — making it effortless to understand, compare, and communicate large numbers across both systems.
        </p>
      </div>
    </section>

    <!-- ═══════════════ MISSION ═══════════════ -->
    <section class="band-canvas section-band">
      <div class="page-container">
        <div class="section-header">
          <span class="eyebrow">Our Mission</span>
          <h2 class="display-lg">Two systems, one number — zero confusion.</h2>
          <p class="body-md" style="color: var(--color-body); max-width: 640px;">
            Whether you're reading a financial report in Mumbai or New York, the same number looks different. 1,00,00,000 is not the same grouping as 10,000,000 — yet they represent the exact same value. Our mission is to make that translation instant and error-free.
          </p>
        </div>

        <div class="features-grid">
          <!-- Mission Card 1 -->
          <div class="feature-card card shadow-level-3">
            <div class="feature-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <h3 class="display-sm">Bridging Global Systems</h3>
            <p class="body-sm" style="color: var(--color-body);">
              The Indian number system (Lakh, Crore, Arab) and the International system (Million, Billion, Trillion) serve billions of people worldwide. We make it simple to move between them — no memorization, no mental math, no mistakes.
            </p>
          </div>

          <!-- Mission Card 2 -->
          <div class="feature-card card shadow-level-3">
            <div class="feature-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </div>
            <h3 class="display-sm">Clarity Over Complexity</h3>
            <p class="body-sm" style="color: var(--color-body);">
              Large numbers are hard enough to read without struggling with unfamiliar grouping conventions. The converter provides full word expansion in both systems, so you don't just get the formatting — you get the meaning.
            </p>
          </div>

          <!-- Mission Card 3 -->
          <div class="feature-card card shadow-level-3">
            <div class="feature-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3 class="display-sm">Built for Everyone</h3>
            <p class="body-sm" style="color: var(--color-body);">
              Students learning number systems, professionals working across borders, journalists reporting figures, and anyone who has ever wondered "how much is a crore in millions?" — this tool is for you.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════ BUILT FOR CLARITY ═══════════════ -->
    <section class="band-canvas-soft section-band">
      <div class="page-container">
        <div class="section-header">
          <span class="eyebrow">Built for Clarity</span>
          <h2 class="display-lg">Free, instant, and entirely in your browser.</h2>
          <p class="body-md" style="color: var(--color-body); max-width: 640px;">
            No sign-ups, no downloads, no data leaving your device. The Number System Converter is designed to do one thing exceptionally well — and nothing else.
          </p>
        </div>

        <div class="clarity-grid">
          <div class="clarity-item card shadow-level-2">
            <div class="clarity-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span class="clarity-label">Free Forever</span>
            </div>
            <p class="body-sm" style="color: var(--color-body);">
              No premium tier, no usage limits, no paywall. Every feature is available to everyone, always.
            </p>
          </div>

          <div class="clarity-item card shadow-level-2">
            <div class="clarity-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              <span class="clarity-label">Instant Results</span>
            </div>
            <p class="body-sm" style="color: var(--color-body);">
              Type a number and see both number system representations immediately. No waiting, no loading, no round trips to a server.
            </p>
          </div>

          <div class="clarity-item card shadow-level-2">
            <div class="clarity-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span class="clarity-label">Private by Design</span>
            </div>
            <p class="body-sm" style="color: var(--color-body);">
              All conversion happens in your browser. Your numbers never leave your device — no servers, no logs, no tracking.
            </p>
          </div>

          <div class="clarity-item card shadow-level-2">
            <div class="clarity-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              <span class="clarity-label">Works Everywhere</span>
            </div>
            <p class="body-sm" style="color: var(--color-body);">
              Desktop, tablet, or phone — the converter adapts to your screen. Works offline once loaded, with no installation required.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════ OPEN & ACCESSIBLE ═══════════════ -->
    <section class="band-ink section-band">
      <div class="page-container">
        <div class="section-header section-header-dark">
          <span class="eyebrow" style="color: rgba(255,255,255,0.5);">Open & Accessible</span>
          <h2 class="display-lg" style="color: #fff;">No data leaves your browser. Ever.</h2>
          <p class="body-md" style="color: rgba(255,255,255,0.65); max-width: 640px;">
            The Number System Converter is a fully client-side application. Every calculation, every formatting operation, every word expansion — it all happens right here, in your browser tab.
          </p>
        </div>

        <div class="open-features">
          <div class="open-feature">
            <div class="open-feature-icon">🔒</div>
            <h3 class="display-sm" style="color: #fff;">Zero Data Collection</h3>
            <p class="body-sm" style="color: rgba(255,255,255,0.7);">We don't collect, store, or transmit any numbers you enter. There are no analytics tracking your inputs, no server logs recording conversions.</p>
          </div>
          <div class="open-feature">
            <div class="open-feature-icon">🌐</div>
            <h3 class="display-sm" style="color: #fff;">No Server Dependency</h3>
            <p class="body-sm" style="color: rgba(255,255,255,0.7);">The entire converter is a static site. Once the page loads, you can disconnect from the internet and it will keep working perfectly.</p>
          </div>
          <div class="open-feature">
            <div class="open-feature-icon">🌙</div>
            <h3 class="display-sm" style="color: #fff;">Dark Mode Built In</h3>
            <p class="body-sm" style="color: rgba(255,255,255,0.7);">Your theme preference is saved locally in your browser's localStorage. That's the only data we store — and it never leaves your device.</p>
          </div>
        </div>
      </div>
    </section>
    <!-- ═══════════════ METHOD & ACCURACY ═══════════════ -->
    <section class="band-canvas section-band" id="method">
      <div class="page-container">
        <div class="section-header">
          <span class="eyebrow">Method &amp; accuracy</span>
          <h2 class="display-lg">How the numbers on this site are checked.</h2>
          <p class="body-md" style="color: var(--color-body); max-width: 680px;">
            Every scale value and every worked example is checked against a single 10ⁿ reference table, then cross-checked in the opposite direction. The table is published, so you can audit the same numbers we use.
          </p>
        </div>

        <div class="features-grid">
          <div class="feature-card card shadow-level-3">
            <h3 class="display-sm">Single source of truth</h3>
            <p class="body-sm" style="color: var(--color-body);">
              The Indian scale (lakh 10⁵, crore 10⁷, arab 10⁹, kharab 10¹¹, neel 10¹³, padma 10¹⁵, shankh 10¹⁷) and the International short scale (million 10⁶, billion 10⁹, trillion 10¹²) are stored once in the site data. The converter, the tables and the guides all read from it, so a correction propagates everywhere.
            </p>
          </div>
          <div class="feature-card card shadow-level-3">
            <h3 class="display-sm">Round-trip checks</h3>
            <p class="body-sm" style="color: var(--color-body);">
              Base conversions are verified in both directions: decimal → binary → decimal, and decimal → hex → decimal. Naming conversions are checked against the anchors 1 million = 10 lakh, 1 billion = 1 arab = 100 crore, and 1 trillion = 1 lakh crore.
            </p>
          </div>
          <div class="feature-card card shadow-level-3">
            <h3 class="display-sm">Editorial standard</h3>
            <p class="body-sm" style="color: var(--color-body);">
              Guides are written and reviewed by the NumSys editorial team and dated on the page. We cite standards bodies for conventions rather than other calculator sites. If you find an error, the <a href="/contact/">contact page</a> reaches the person who can fix it.
            </p>
          </div>
        </div>

        <p class="body-sm" style="color: var(--color-body); max-width: 760px; margin: var(--spacing-2xl) auto 0; text-align: center;">
          References for the conventions used here:
          <a href="https://www.bipm.org/en/committees/cg" target="_blank" rel="noopener noreferrer">BIPM / CGPM</a> for the short-scale standard,
          <a href="https://www.nist.gov/pml/special-publication-811" target="_blank" rel="noopener noreferrer">NIST SP 811</a> for unit and number style,
          and <a href="https://cldr.unicode.org/" target="_blank" rel="noopener noreferrer">Unicode CLDR</a> for locale digit grouping.
          Page last reviewed: <time datetime="2026-10-27">27 October 2026</time>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ════════════ HERO ════════════ */
  .hero-band {
    padding: var(--spacing-section) var(--spacing-lg) var(--spacing-6xl);
    text-align: center;
    position: relative;
    overflow: hidden;
    background-color: var(--color-canvas-soft);
  }

  .hero-content {
    position: relative;
    z-index: 2.
    display: flex.
    flex-direction: column.
    align-items: center.
    gap: var(--spacing-lg).
    max-width: 800px.
    margin-inline: auto.
  }

  .hero-eyebrow {
    color: var(--color-violet).
    margin-bottom: 0.
  }

  .hero-headline {
    color: var(--color-ink).
  }

  .hero-lead {
    color: var(--color-body).
    max-width: 620px.
  }

  /* ════════════ SECTION BAND ════════════ */
  .section-band {
    padding: var(--spacing-5xl) var(--spacing-lg).
  }

  .section-header {
    text-align: center.
    display: flex.
    flex-direction: column.
    align-items: center.
    gap: var(--spacing-sm).
    margin-bottom: var(--spacing-4xl).
  }

  .section-header-dark .eyebrow {
    color: rgba(255,255,255,0.5).
  }

  .section-header h2 {
    color: var(--color-ink).
  }

  /* ════════════ FEATURES GRID ════════════ */
  .features-grid {
    display: grid.
    grid-template-columns: 1fr 1fr 1fr.
    gap: var(--spacing-lg).
  }

  .feature-card {
    padding: var(--spacing-lg).
  }

  .feature-icon-wrap {
    width: 40px.
    height: 40px.
    display: flex.
    align-items: center.
    justify-content: center.
    border-radius: var(--radius-md).
    background: var(--color-link-bg-soft).
    color: var(--color-link).
    margin-bottom: var(--spacing-md).
  }

  .feature-card h3 {
    color: var(--color-ink).
    margin-bottom: var(--spacing-sm).
  }

  /* ════════════ CLARITY GRID ════════════ */
  .clarity-grid {
    display: grid.
    grid-template-columns: 1fr 1fr.
    gap: var(--spacing-lg).
  }

  .clarity-item {
    padding: var(--spacing-lg).
  }

  .clarity-badge {
    display: flex.
    align-items: center.
    gap: var(--spacing-xs).
    margin-bottom: var(--spacing-sm).
    color: var(--color-link).
  }

  .clarity-label {
    font-weight: 500.
    font-size: 16px.
    color: var(--color-ink).
  }

  /* ════════════ OPEN FEATURES (DARK BAND) ════════════ */
  .open-features {
    display: grid.
    grid-template-columns: 1fr 1fr 1fr.
    gap: var(--spacing-lg).
  }

  .open-feature {
    padding: var(--spacing-lg).
    background: rgba(255,255,255,0.04).
    border: 1px solid rgba(255,255,255,0.08).
    border-radius: var(--radius-md).
  }

  .open-feature-icon {
    font-size: 24px.
    margin-bottom: var(--spacing-sm).
  }

  .open-feature h3 {
    margin-bottom: var(--spacing-xs).
  }

  /* ════════════ RESPONSIVE ════════════ */
  @media (max-width: 959px) {
    .features-grid {
      grid-template-columns: 1fr 1fr.
    }

    .open-features {
      grid-template-columns: 1fr 1fr.
    }
  }

  @media (max-width: 600px) {
    .hero-band {
      padding: 96px var(--spacing-md) 64px.
    }

    .section-band {
      padding: var(--spacing-4xl) var(--spacing-md).
    }

    .features-grid {
      grid-template-columns: 1fr.
    }

    .clarity-grid {
      grid-template-columns: 1fr.
    }

    .open-features {
      grid-template-columns: 1fr.
    }
  }
</style>