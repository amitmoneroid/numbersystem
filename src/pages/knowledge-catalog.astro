---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';
import { guides, guideHref } from '../data/guides';
import { nuances, worldSystems } from '../data/worldSystems';

const canonical = 'https://numbersystemconverter.com/knowledge-catalog/';

const catalogFaqs = [
  {
    question: 'Why does “billion” mean different amounts in different languages?',
    answer:
      'English uses the <strong>short scale</strong>: a new name every 1,000× (billion = 10⁹, trillion = 10¹²). Portuguese, Spanish, French, German, Italian and Dutch keep the <strong>long scale</strong>: a new name every 1,000,000×, so their “billion” starts at 10¹² and they keep a separate word (milliard, mil milhões, Milliarde) for 10⁹.',
  },
  {
    question: 'Which languages group digits in fours instead of threes?',
    answer:
      'Japanese, Chinese and Korean. 万 (man / wàn) is 10⁴, 億 (oku / yì) is 10⁸ and 兆 (chō / zhào) is 10¹². That is why there is no native word for 10⁹ — one billion is written 十億, “ten hundred-million”.',
  },
  {
    question: 'How do I convert a Portuguese bilião to Indian crore?',
    answer:
      'In Portugal, 1 bilião = 10¹² = 1 trillion = <strong>1 lakh crore</strong>. In Brazil, 1 bilhão = 10⁹ = 1 billion = <strong>100 crore</strong>. Always check which side of the Atlantic the text comes from before converting.',
  },
  {
    question: 'What is the difference between a base and a number system?',
    answer:
      'A <strong>base</strong> (radix) is how many digits a positional system uses — binary is base 2, octal base 8, decimal base 10, hexadecimal base 16. A <strong>number system</strong> in everyday use can also mean the naming convention for large values (lakh and crore versus million and billion). Both are base 10, but they group digits differently.',
  },
];

const sections = [
  { id: 'utility', label: 'Utility' },
  { id: 'use-cases', label: 'Use cases' },
  { id: 'quick-education', label: 'Quick Education' },
  { id: 'target-audience', label: 'Audience' },
  { id: 'tech-stack', label: 'Tech stack' },
  { id: 'catalog-faq', label: 'FAQ' },
];
---

<Layout
  title="Number System Knowledge Catalog – Tables & World Scales"
  description="Browse number system guides: converters with steps, online calculators, conversion tables and PDFs, plus how 16 languages name big numbers."
  canonicalURL={canonical}
  keywords="number system knowledge catalog, number system converter with steps, number system converter online, number system conversion calculator with solution, number system conversion pdf, base converter calculator, number system conversion table, world number systems"
  breadcrumbs={[
    { name: 'Home', url: 'https://numbersystemconverter.com/' },
    { name: 'Knowledge Catalog', url: canonical },
  ]}
  faqItems={catalogFaqs}
>
  <Navbar />

  <main class="catalog-page">
    <header class="catalog-hero mesh-gradient">
      <div class="page-container">
        <span class="eyebrow">Knowledge Catalog</span>
        <h1 class="catalog-title">Number System Knowledge Catalog</h1>
        <p class="catalog-lead">
          Every explanation, table and worked example behind the converter — plus a directory of guides on how the world names big numbers, and how each system benchmarks against the International scale.
        </p>
        <div class="catalog-stats">
          <div class="catalog-stat">
            <span class="stat-number code">{worldSystems.length}</span>
            <span class="stat-label">numbering systems compared</span>
          </div>
          <div class="catalog-stat">
            <span class="stat-number code">{guides.length}</span>
            <span class="stat-label">in-depth guides</span>
          </div>
          <div class="catalog-stat">
            <span class="stat-number code">13+</span>
            <span class="stat-label">Indian &amp; International scales</span>
          </div>
          <div class="catalog-stat">
            <span class="stat-number code">2–36</span>
            <span class="stat-label">bases supported</span>
          </div>
        </div>
      </div>
    </header>

    <nav class="catalog-jump" aria-label="Catalog sections">
      <div class="page-container jump-inner">
        <span class="jump-label">Jump to</span>
        {sections.map((section) => (
          <a class="jump-pill" href={`#${section.id}`}>{section.label}</a>
        ))}
      </div>
    </nav>

    <div class="page-container catalog-body">
      <!-- Utility -->
      <section id="utility" class="catalog-card card shadow-level-2">
        <div class="card-head">
          <span class="card-index code">01</span>
          <div>
            <h2 class="card-title">Utility: what the converter does</h2>
            <p class="card-lead">
              A microtool for two jobs: translating between the Indian and International naming systems, and converting between positional bases with the working shown.
            </p>
          </div>
        </div>
        <div class="mini-grid">
          <div class="mini-card">
            <h3>Precision conversion</h3>
            <p>Accurately converts values between International (thousand, million, billion) and Indian (lakh, crore, arab) systems with full word expansion.</p>
          </div>
          <div class="mini-card">
            <h3>Multiple scales</h3>
            <p>Thirteen named scales, from thousand and lakh up to shankh, quadrillion and quintillion.</p>
          </div>
          <div class="mini-card">
            <h3>Base 2 to 36</h3>
            <p>Binary, octal, decimal, hexadecimal and every radix in between, with positional expansion and repeated division shown.</p>
          </div>
          <div class="mini-card">
            <h3>Educational value</h3>
            <p>Every result is paired with the formatting difference between the two systems, so the logic is visible rather than hidden.</p>
          </div>
        </div>
      </section>

      <!-- Use cases -->
      <section id="use-cases" class="catalog-card card shadow-level-2">
        <div class="card-head">
          <span class="card-index code">02</span>
          <div>
            <h2 class="card-title">Use cases</h2>
            <p class="card-lead">Where a number system conversion is the difference between a correct decision and a 1,000× error.</p>
          </div>
        </div>
        <div class="mini-grid">
          <div class="mini-card">
            <h3>Financial news analysis</h3>
            <p>Converting ₹2.5 crore to its International equivalent, or reading a US$394 billion figure as 39.4 arab, keeps cross-border comparisons honest.</p>
          </div>
          <div class="mini-card">
            <h3>Academic research</h3>
            <p>Standardising international datasets against Indian economic data: 1 billion = 1 arab = 100 crore.</p>
          </div>
          <div class="mini-card">
            <h3>Business reporting</h3>
            <p>Presenting the same revenue in locally understood terms while holding a single global figure behind it.</p>
          </div>
          <div class="mini-card">
            <h3>Digital logic study</h3>
            <p>Verifying manual binary, octal and hexadecimal arithmetic with the division steps visible.</p>
          </div>
        </div>
      </section>

      <!-- Quick Education + directory -->
      <section id="quick-education" class="catalog-card card shadow-level-2">
        <div class="card-head">
          <span class="card-index code">03</span>
          <div>
            <h2 class="card-title">Quick Education</h2>
            <p class="card-lead">
              Start with the grouping rule, then follow the guide that matches what you are trying to do. Each guide covers one keyword in depth and benchmarks the world’s numbering systems against the International scale.
            </p>
          </div>
        </div>

        <div class="edu-grid">
          <div class="edu-card">
            <h3>Core difference in grouping</h3>
            <p>International counts in thousands: 3 digits per group. Indian counts in hundreds after the first thousand: 3 digits, then pairs.</p>
            <div class="equation">
              <span class="code">International: 1,000 · 1,000,000 · 1,000,000,000</span>
              <span class="code">Indian: 1,000 · 1,00,000 · 1,00,00,000</span>
            </div>
          </div>
          <div class="edu-card">
            <h3>Practical conversion examples</h3>
            <ul class="edu-list">
              <li>1 million = 10 lakh</li>
              <li>1 billion = 1 arab = 100 crore</li>
              <li>1 trillion = 1 lakh crore</li>
              <li>1 kharab = 100 billion</li>
              <li>1 shankh = 100 quadrillion</li>
            </ul>
          </div>
          <div class="edu-card">
            <h3>Visual difference</h3>
            <p>Comma placement is the fastest way to tell which system a document uses.</p>
            <div class="equation">
              <span class="code">International: 1,000,000,000</span>
              <span class="code">Indian: 1,00,00,00,000</span>
            </div>
          </div>
          <div class="edu-card">
            <h3>World benchmark</h3>
            <p>Long-scale languages (Portuguese, Spanish, French, German) put “billion” at 10¹²; Japanese and Korean have no word for 10⁹ at all.</p>
            <a class="inline-link" href="/knowledge-catalog/number-system-conversion-table/">See the full benchmark table →</a>
          </div>
        </div>

        <div class="directory-head">
          <h2 class="directory-title">Number system guides directory</h2>
          <p class="card-lead">Six pages, one per search intent. Every page includes the world numbering comparison and a worked path back to the converter.</p>
        </div>

        <div class="directory-grid">
          {guides.map((guide) => (
            <a class="directory-card" href={guideHref(guide.slug)}>
              <span class="directory-meta">
                <span class="directory-tag">{guide.shortLabel}</span>
                <span>{guide.readingMinutes} min</span>
              </span>
              <h2 class="directory-heading">{guide.h1}</h2>
              <p class="directory-summary">{guide.summary}</p>
              <span class="directory-more">Open guide →</span>
            </a>
          ))}
        </div>

        <div class="nuance-strip">
          {nuances.slice(0, 5).map((item) => (
            <div class="nuance-mini">
              <span class="nuance-mini-title"><span class="nuance-code">{item.code}</span>{item.title}</span>
              <span class="nuance-mini-body">{item.body}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Audience -->
      <section id="target-audience" class="catalog-card card shadow-level-2">
        <div class="card-head">
          <span class="card-index code">04</span>
          <div>
            <h2 class="card-title">Who it is for</h2>
            <p class="card-lead">Anyone who has to move a number across a language, a currency or a base without losing a zero.</p>
          </div>
        </div>
        <div class="mini-grid">
          <div class="mini-card">
            <h3>Finance professionals</h3>
            <p>Analysts, bankers and advisors reading international reports in Indian terms, or the reverse.</p>
          </div>
          <div class="mini-card">
            <h3>Students &amp; educators</h3>
            <p>Learners of mathematics, digital logic and economics who need the method, not only the answer.</p>
          </div>
          <div class="mini-card">
            <h3>Business owners</h3>
            <p>Teams handling cross-border transactions, valuations and investor updates.</p>
          </div>
          <div class="mini-card">
            <h3>Researchers &amp; analysts</h3>
            <p>Anyone normalising datasets that mix lakh/crore with million/billion, or Arabic-Indic digits with Western ones.</p>
          </div>
          <div class="mini-card">
            <h3>Translators &amp; journalists</h3>
            <p>Localising a “billion” from Portuguese, Spanish or French without inflating it a thousand times.</p>
          </div>
          <div class="mini-card">
            <h3>General readers</h3>
            <p>Anyone who meets a large number in the news and wants a quick, trustworthy read.</p>
          </div>
        </div>
      </section>

      <!-- Tech stack -->
      <section id="tech-stack" class="catalog-card card shadow-level-2">
        <div class="card-head">
          <span class="card-index code">05</span>
          <div>
            <h2 class="card-title">How it is built</h2>
            <p class="card-lead">A static site with client-side arithmetic — fast to load, private by default, and usable offline once open.</p>
          </div>
        </div>
        <div class="stack-grid">
          <div class="stack-row"><span class="stack-key">Framework</span><span class="stack-value">Astro, static output with zero framework JavaScript</span></div>
          <div class="stack-row"><span class="stack-key">Styling</span><span class="stack-value">CSS custom properties with light and dark themes</span></div>
          <div class="stack-row"><span class="stack-key">Logic</span><span class="stack-value">TypeScript conversion functions running in the browser</span></div>
          <div class="stack-row"><span class="stack-key">Privacy</span><span class="stack-value">No conversion data is transmitted or stored</span></div>
          <div class="stack-row"><span class="stack-key">Accessibility</span><span class="stack-value">Keyboard reachable controls, labelled inputs, live result announcements</span></div>
        </div>
      </section>

      <!-- FAQ -->
      <section id="catalog-faq" class="catalog-card card shadow-level-2">
        <div class="card-head">
          <span class="card-index code">06</span>
          <div>
            <h2 class="card-title">Catalog FAQ</h2>
            <p class="card-lead">The questions that come up most often when comparing numbering systems across languages.</p>
          </div>
        </div>
        <FAQ items={catalogFaqs} heading="World numbering questions, answered" intro="Short answers to the cross-language questions this catalog receives most often." />
      </section>

      <div class="catalog-cta">
        <div>
          <h2 class="cta-title">Ready to convert something?</h2>
          <p class="card-lead" style="margin: 0;">The converter is free, instant and works offline once loaded.</p>
        </div>
        <a class="cta-button" href="/#converter">Open the number system converter</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .catalog-page {
    background: var(--color-canvas-soft);
  }

  .catalog-hero {
    padding-block: var(--spacing-5xl) var(--spacing-4xl);
    border-bottom: 1px solid var(--color-hairline);
    background-color: var(--color-canvas-soft);
  }

  .catalog-title {
    font-size: 48px;
    line-height: 1.06;
    letter-spacing: -2px;
    font-weight: 600;
    color: var(--color-ink);
    margin: var(--spacing-sm) 0 var(--spacing-md);
    max-width: 20ch;
  }

  .catalog-lead {
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
    max-width: 70ch;
    margin: 0;
  }

  .catalog-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--spacing-md);
    margin-top: var(--spacing-2xl);
    max-width: 760px;
  }

  .catalog-stat {
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--spacing-sm);
  }

  .stat-number {
    display: block;
    font-family: var(--font-mono);
    font-size: 26px;
    color: var(--color-ink);
    letter-spacing: -1px;
  }

  .stat-label {
    display: block;
    font-size: 12px;
    color: var(--color-mute);
    line-height: 1.4;
  }

  .catalog-jump {
    position: sticky;
    top: 64px;
    z-index: 20;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
  }

  .jump-inner {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    overflow-x: auto;
    padding-block: var(--spacing-sm);
  }

  .jump-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-mute);
    white-space: nowrap;
    margin-right: var(--spacing-xs);
  }

  .jump-pill {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft);
    color: var(--color-body);
    font-size: 12px;
    text-decoration: none;
    white-space: nowrap;
  }

  .jump-pill:hover {
    color: var(--color-ink);
    border-color: var(--color-hairline-strong);
  }

  .catalog-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    padding-block: var(--spacing-3xl) var(--spacing-5xl);
  }

  .catalog-card {
    background: var(--color-canvas);
    border-radius: var(--radius-xl);
    padding: var(--spacing-2xl);
    scroll-margin-top: 112px;
  }

  .card-head {
    display: flex;
    gap: var(--spacing-md);
    align-items: flex-start;
    margin-bottom: var(--spacing-2xl);
  }

  .card-index {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-mute);
    padding-top: 4px;
  }

  .card-title {
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: -1px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 6px;
  }

  .card-lead {
    font-size: 15px;
    line-height: 23px;
    color: var(--color-body);
    margin: 0;
    max-width: 68ch;
  }

  .mini-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--spacing-md);
  }

  .mini-card {
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
  }

  .mini-card h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 6px;
  }

  .mini-card p {
    font-size: 13px;
    line-height: 20px;
    color: var(--color-body);
    margin: 0;
  }

  .edu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-3xl);
  }

  .edu-card {
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
  }

  .edu-card h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 6px;
  }

  .edu-card p,
  .edu-card li {
    font-size: 13px;
    line-height: 20px;
    color: var(--color-body);
  }

  .edu-list {
    margin: 0;
    padding-left: var(--spacing-md);
    display: grid;
    gap: 4px;
  }

  .equation {
    display: grid;
    gap: 4px;
    margin-top: var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-sm);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
  }

  .equation .code,
  .equation code {
    font-size: 12px;
    color: var(--color-ink);
  }

  .inline-link {
    display: inline-block;
    margin-top: var(--spacing-sm);
    font-size: 13px;
  }

  .directory-head {
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-lg);
  }

  .directory-title {
    font-size: 22px;
    line-height: 1.25;
    letter-spacing: -0.8px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 6px;
  }

  .directory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-md);
  }

  .directory-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--spacing-lg);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    background: var(--color-canvas-soft);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .directory-card:hover {
    border-color: var(--color-hairline-strong);
    transform: translateY(-2px);
    color: inherit;
  }

  .directory-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-mute);
  }

  .directory-tag {
    padding: 2px 7px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
  }

  .directory-heading {
    font-size: 17px;
    line-height: 1.3;
    letter-spacing: -0.5px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 4px 0 0;
  }

  .directory-summary {
    font-size: 13px;
    line-height: 20px;
    color: var(--color-body);
    margin: 0;
  }

  .directory-more {
    margin-top: auto;
    padding-top: var(--spacing-sm);
    font-size: 13px;
    color: var(--color-link);
  }

  .nuance-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--spacing-md);
    margin-top: var(--spacing-xl);
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--spacing-lg);
  }

  .nuance-mini-title {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 4px;
  }

  .nuance-code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 17px;
    margin-right: 6px;
    padding: 0 4px;
    border-radius: 3px;
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    color: var(--color-mute);
    vertical-align: 1px;
  }

  .nuance-mini-body {
    display: block;
    font-size: 12px;
    line-height: 19px;
    color: var(--color-body);
  }

  .stack-grid {
    display: grid;
    gap: 1px;
    background: var(--color-hairline);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .stack-row {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-canvas);
  }

  .stack-key {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-mute);
  }

  .stack-value {
    font-size: 13px;
    color: var(--color-ink);
  }

  /* The FAQ component renders its own section band; flatten it inside the card. */
  .catalog-card :global(#faq) {
    padding: 0;
    background: transparent;
  }

  .catalog-card :global(#faq .page-container) {
    padding-inline: 0;
    max-width: none;
  }

  .catalog-card :global(#faq .section-header) {
    display: none;
  }

  .catalog-card :global(#faq .faq-list) {
    max-width: none;
  }

  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--spacing-md);
  }

  .roadmap-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
    background: var(--color-canvas-soft);
  }

  .roadmap-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--color-link-bg-soft);
    color: var(--color-link-deep);
    font-family: var(--font-mono);
