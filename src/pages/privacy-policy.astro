---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Privacy Policy – Number System Converter';
const pageDescription = 'Privacy policy for the Number System Converter: what stays in your browser, the optional analytics we use, and the choices you control.';
const pageCanonical = 'https://numbersystemconverter.com/privacy-policy/';
const pageKeywords = 'privacy policy, number system converter privacy, data collection, cookies, local storage, client-side converter';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={pageCanonical}
  keywords={pageKeywords}
>
  <Navbar />

  <main id="main">
    <!-- ═══════════════ HERO BAND ═══════════════ -->
    <section class="hero-band mesh-gradient">
      <div class="page-container hero-content">
        <span class="eyebrow hero-eyebrow">Legal</span>
        <h1 class="display-xl hero-headline">Number System Converter Privacy Policy.</h1>
        <p class="body-lg hero-lead">
          Your privacy matters to us. This policy explains what the Number System Converter stores, which optional analytics it uses, and how you can control both.
        </p>
        <p class="last-updated caption-mono">Last updated: November 1, 2026</p>
      </div>
    </section>

    <!-- ═══════════════ CONTENT ═══════════════ -->
    <section class="band-canvas-soft section-band">
      <div class="page-container">
        <article class="prose">

          <!-- Introduction -->
          <div class="prose-section">
            <h2 class="display-sm">Introduction to the Number System Converter privacy policy.</h2>
            <p class="body-md">The Number System Converter ("we", "our", "the Tool") is a free, client-side web application that converts numbers between Indian and International number systems. Because the conversion runs entirely in your browser, the numbers you enter are never sent to us. This policy describes the small amount of data the site does handle: your theme preference, your analytics choice, and — only if you accept — standard Google Analytics page metrics.</p>
          </div>

          <!-- Information We Collect -->
          <div class="prose-section">
            <h2 class="display-sm">Information the Number System Converter collects.</h2>
            <p class="body-md"><strong>The numbers you enter are never collected.</strong> The Number System Converter does not require you to create an account, sign in, or provide personal details such as your name, email address, or phone number.</p>
            <p class="body-md">The values you type are processed entirely within your browser. They are never transmitted to our servers or to any analytics service. When you close the tab or navigate away, the input is gone.</p>
            <p class="body-md">If you choose <strong>Accept analytics</strong>, Google Analytics 4 records standard usage data: pages viewed, approximate location (city level), device and browser type, referring site, and interactions such as opening the PDF. This helps us decide which guides to improve. If you decline, the analytics script is not loaded at all.</p>
          </div>

          <!-- How We Use Information -->
          <div class="prose-section">
            <h2 class="display-sm">How the Number System Converter uses information.</h2>
            <p class="body-md">Aggregate analytics is used to understand which pages and guides are useful, to find broken or confusing pages, and to prioritise new content. We do not sell data, build advertising profiles, or use the numbers you enter for any purpose.</p>
          </div>

          <!-- Cookies & Local Storage -->
          <div class="prose-section">
            <h2 class="display-sm">Number System Converter cookies and local storage.</h2>
            <p class="body-md">The Number System Converter uses your browser's <strong>localStorage</strong> for two preferences:</p>
            <div class="code-block">
              <code>Key: "theme" &nbsp;|&nbsp; Value: "light" or "dark"</code><br />
              <code>Key: "analytics-consent" &nbsp;|&nbsp; Value: "granted" or "denied"</code>
            </div>
            <p class="body-md">Both stay on your device and are never sent to a server. You can clear them at any time by clearing your browser's local storage for this site.</p>
            <p class="body-md">If you accept analytics, Google Analytics sets first-party cookies (<code>_ga</code> and <code>_ga_*</code>) to distinguish sessions. They are used only for aggregate measurement, not advertising, and expire after up to two years. If you decline, no analytics cookies are set.</p>
          </div>

          <!-- Third-Party Services -->
          <div class="prose-section">
            <h2 class="display-sm">Third-Party Services.</h2>
            <p class="body-md">The Number System Converter serves its fonts from this domain; no Google Fonts request is made. The only third-party resource is optional analytics:</p>
            <ul class="prose-list">
              <li><strong>Google Analytics 4</strong> — Loaded only after you accept analytics. It measures aggregate page views and interactions. Google Analytics 4 does not log or store IP addresses, and we never send the numbers you enter. See <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">how Google uses data</a>.</li>
            </ul>
            <p class="body-md">We do not integrate advertising networks, social media trackers, or data brokers.</p>
          </div>

          <!-- Your Choices -->
          <div class="prose-section">
            <h2 class="display-sm">Your Choices.</h2>
            <p class="body-md">You control analytics at every step:</p>
            <ul class="prose-list">
              <li>Choose <strong>Decline</strong> in the consent banner and no analytics script is loaded.</li>
              <li>Change your mind at any time with the <strong>Analytics settings</strong> link in the footer.</li>
              <li>Block or delete cookies in your browser settings; the converter continues to work.</li>
              <li>Install the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics opt-out browser add-on</a>.</li>
            </ul>
          </div>

          <!-- Data Security -->
          <div class="prose-section">
            <h2 class="display-sm">Data Security.</h2>
            <p class="body-md">All processing happens client-side and we do not store the values you enter on our servers, so the attack surface for data breaches is minimal. The tool is served over HTTPS to ensure the integrity of the code delivered to your browser.</p>
          </div>

          <!-- Children's Privacy -->
          <div class="prose-section">
            <h2 class="display-sm">Children's Privacy.</h2>
            <p class="body-md">The Number System Converter is a general-audience educational tool. We do not knowingly collect personal information from children under 13. The converter does not ask for personal details, and analytics remains off unless the visitor opts in.</p>
          </div>

          <!-- Changes -->
          <div class="prose-section">
            <h2 class="display-sm">Changes to This Policy.</h2>
            <p class="body-md">We may update this privacy policy from time to time. Any changes will be posted on this page with an updated "Last updated" date. Your continued use of the tool after any changes constitutes your acceptance of the revised policy.</p>
          </div>

          <!-- Contact -->
          <div class="prose-section">
            <h2 class="display-sm">Contact Us.</h2>
            <p class="body-md">If you have any questions about this privacy policy, please reach out to us through our <a href="/contact/">Contact page</a>.</p>
          </div>

        </article>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ════════════ HERO ════════════ */
  .hero-band {
    padding: var(--spacing-section) var(--spacing-lg) var(--spacing-6xl);
    text-align: center;
    position: relative;
    overflow: hidden;
    background-color: var(--color-canvas-soft);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-lg);
    max-width: 800px;
    margin-inline: auto;
  }

  .hero-eyebrow {
    color: var(--color-violet);
    margin-bottom: 0;
  }

  .hero-headline {
    color: var(--color-ink);
  }

  .hero-lead {
    color: var(--color-body);
    max-width: 620px;
  }

  .last-updated {
    color: var(--color-mute);
    margin-top: 0;
  }

  /* ════════════ SECTION BAND ════════════ */
  .section-band {
    padding: var(--spacing-5xl) var(--spacing-lg);
  }

  /* ════════════ PROSE ════════════ */
  .prose {
    max-width: 720px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4xl);
  }

  .prose-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .prose-section h2 {
    color: var(--color-ink);
    margin-bottom: var(--spacing-xs);
  }

  .prose-section p {
    color: var(--color-body);
  }

  .prose-section strong {
    color: var(--color-ink);
    font-weight: 500;
  }

  .prose-section a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose-section a:hover {
    color: var(--color-link-deep);
  }

  .code-block {
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink);
    margin: var(--spacing-sm) 0;
    overflow-x: auto;
  }

  .prose-list {
    padding-left: var(--spacing-lg);
    margin: var(--spacing-sm) 0;
    color: var(--color-body);
    font-size: 16px;
    line-height: 24px;
  }

  .prose-list li {
    margin-bottom: var(--spacing-xs);
  }

  .prose-list strong {
    color: var(--color-ink);
  }

  /* ════════════ RESPONSIVE ════════════ */
  @media (max-width: 600px) {
    .hero-band {
      padding: 96px var(--spacing-md) 64px;
    }

    .section-band {
      padding: var(--spacing-4xl) var(--spacing-md);
    }
  }
</style>