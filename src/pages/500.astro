---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pageTitle = '500 – Internal Server Error | Number System Converter';
const pageDescription = 'Something went wrong on our end. Please try again or return to the Number System Converter homepage.';
const pageCanonical = 'https://numbersystemconverter.com/500';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={pageCanonical}
  ogType="website"
>
  <Navbar />

  <main>
    <section class="error-band">
      <div class="page-container error-content">
        <span class="error-code">500</span>
        <h1 class="display-lg error-headline">Something went wrong.</h1>
        <p class="body-md error-lead">
          An unexpected error occurred on our end. Don't worry — it's not you, it's us.
          Try refreshing or head back to the homepage.
        </p>
        <div class="error-ctas">
          <a href="/" class="btn btn-primary">Back to Home</a>
          <button onclick="location.reload()" class="btn btn-secondary">Try Again</button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .error-band {
    padding: var(--spacing-section) var(--spacing-lg);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
  }

  .error-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-lg);
    max-width: 560px;
  }

  .error-code {
    font-family: var(--font-mono);
    font-size: 96px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -4px;
    background: linear-gradient(135deg, var(--color-gradient-ship-start), var(--color-gradient-ship-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .error-headline {
    color: var(--color-ink);
  }

  .error-lead {
    color: var(--color-body);
    max-width: 480px;
  }

  .error-ctas {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--spacing-sm);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all 0.15s ease;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: var(--color-ink);
    color: var(--color-on-primary);
    font-size: 16px;
    line-height: 24px;
    padding: 12px 24px;
  }

  .btn-primary:hover {
    background: #000;
    color: #fff;
  }

  .dark .btn-primary {
    background: #ededed;
    color: #0a0a0a;
  }

  .dark .btn-primary:hover {
    background: #fff;
    color: #000;
  }

  .btn-secondary {
    background: var(--color-canvas);
    color: var(--color-ink);
    font-size: 16px;
    line-height: 24px;
    padding: 12px 24px;
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }

  .btn-secondary:hover {
    background: var(--color-canvas-soft-2);
  }

  .dark .btn-secondary {
    background: #1a1a1a;
    color: #ededed;
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }

  .dark .btn-secondary:hover {
    background: #2e2e2e;
  }

  @media (max-width: 600px) {
    .error-band {
      padding: 96px var(--spacing-md) 64px;
      min-height: 50vh;
    }

    .error-code {
      font-size: 64px;
      letter-spacing: -2.56px;
    }

    .error-ctas {
      flex-direction: column;
      width: 100%;
    }

    .btn-primary, .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
