---
// GuideLayout.astro — shared shell for the /knowledge-catalog/<keyword>/ guides.
// Renders breadcrumbs, article header, optional on-page nav, related guides and
// passes breadcrumb + FAQ data to Layout for structured data.
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { guides, guideHref, type Guide } from '../data/guides';

interface TocItem {
  id: string;
  label: string;
}

interface Props {
  guide: Guide;
  toc?: TocItem[];
  faqs?: { question: string; answer: string }[];
  /** 45–60 word direct answer shown under the H1. Falls back to guide.answer. */
  answer?: string;
  /** In-page anchor (or URL) for the primary CTA. */
  toolHref?: string;
  /** Label for the primary CTA. */
  toolLabel?: string;
}

const {
  guide,
  toc = [],
  faqs = [],
  answer = guide.answer,
  toolHref = '#base-converter',
  toolLabel = 'Open the converter',
} = Astro.props;

const canonical = `https://numbersystemconverter.com${guideHref(guide.slug)}`;
const crumbs = [
  { name: 'Home', url: 'https://numbersystemconverter.com/' },
  { name: 'Knowledge Catalog', url: 'https://numbersystemconverter.com/knowledge-catalog/' },
  { name: guide.h1, url: canonical },
];
const related = guides.filter((g) => g.slug !== guide.slug).slice(0, 3);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: guide.metaTitle,
  description: guide.description,
  url: canonical,
  mainEntityOfPage: { '@id': `${canonical}#webpage` },
  datePublished: guide.published,
  dateModified: guide.updated,
  inLanguage: 'en',
  author: {
    '@type': 'Organization',
    name: 'NumSys Editorial Team',
    url: 'https://numbersystemconverter.com/about/#author',
  },
  publisher: { '@id': 'https://numbersystemconverter.com/#organization' },
  isPartOf: { '@id': 'https://numbersystemconverter.com/#website' },
  about: {
    '@type': 'DefinedTerm',
    name: 'number system and radix conversion',
    inDefinedTermSet: 'https://numbersystemconverter.com/knowledge-catalog/',
  },
  image: 'https://numbersystemconverter.com/og-image.png',
};
---

<Layout
  title={guide.metaTitle}
  description={guide.description}
  canonicalURL={canonical}
  ogType="article"
  keywords={`${guide.h1.toLowerCase()}, number system converter, base converter, conversion table, indian number system, international number system`}
  breadcrumbs={crumbs}
  faqItems={faqs}
  datePublished={guide.published}
  dateModified={guide.updated}
>
  <Fragment slot="head">
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>
  <Navbar />

  <main>
    <nav class="crumbs band-canvas" aria-label="Breadcrumb">
      <div class="page-container crumbs-inner">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/knowledge-catalog/">Knowledge Catalog</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{guide.h1}</span>
      </div>
    </nav>

    <header class="guide-hero mesh-gradient">
      <div class="page-container guide-hero-inner">
        <div>
          <span class="eyebrow">Knowledge Catalog · Guide</span>
          <h1 class="guide-title">{guide.h1}</h1>
          <p class="guide-lead">{guide.description}</p>
          <div class="guide-answer">
            <span class="guide-answer-label">Short answer</span>
            <p>{answer}</p>
          </div>
          <div class="guide-meta">
            <span class="meta-item">By <a href="/about/#author">the NumSys Editorial Team</a></span>
            <span class="meta-dot" aria-hidden="true"></span>
            <span class="meta-item">Published <time datetime={guide.published}>{new Date(guide.published + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></span>
            <span class="meta-dot" aria-hidden="true"></span>
            <span class="meta-item">Updated <time datetime={guide.updated}>{new Date(guide.updated + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></span>
            <span class="meta-dot" aria-hidden="true"></span>
            <span class="meta-item">{guide.readingMinutes} min read</span>
            <span class="meta-dot" aria-hidden="true"></span>
            <span class="meta-item">Examples recomputed before publication</span>
          </div>
        </div>

        <aside class="guide-cta card shadow-level-2">
          <span class="eyebrow">Try it</span>
          <p class="cta-copy">Run the conversion while you read — the tool shows both the answer and the working.</p>
          <a class="cta-btn" href={toolHref}>{toolLabel}</a>
          <a class="cta-link" href="/knowledge-catalog/">Browse all guides →</a>
        </aside>
      </div>
    </header>

    <div class="page-container guide-shell">
      {toc.length > 0 && (
        <nav class="toc" aria-label="On this page">
          <span class="toc-heading">On this page</span>
          <ol class="toc-list">
            {toc.map((item) => (
              <li><a href={`#${item.id}`}>{item.label}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <article class="guide-body" id="article">
        <slot />

        <aside class="guide-sources" aria-label="How this page was checked">
          <strong>How this page was checked.</strong>
          Every example was recomputed against the on-page converter before publication.
          Scale conventions follow
          <a href="https://www.iso.org/standard/76921.html" target="_blank" rel="noopener noreferrer">ISO 80000-1</a>;
          binary fraction limits follow
          <a href="https://standards.ieee.org/ieee/754/6210/" target="_blank" rel="noopener noreferrer">IEEE 754</a>.
          Found an error? <a href="/contact/">Report it here</a> and we will correct the page.
        </aside>
      </article>
    </div>

    {faqs.length > 0 && (
      <section class="guide-faq band-canvas-soft" aria-labelledby="guide-faq-heading">
        <div class="page-container">
          <div class="faq-head">
            <span class="eyebrow">FAQ</span>
            <h2 id="guide-faq-heading" class="display-lg">Questions about {guide.shortLabel.toLowerCase()}</h2>
          </div>
          <div class="faq-grid">
            {faqs.map((item) => (
              <div class="faq-block card shadow-level-2">
                <h3>{item.question}</h3>
                <div set:html={item.answer} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="band-canvas-soft guide-related">
      <div class="page-container">
        <div class="related-head">
          <span class="eyebrow">Keep reading</span>
          <h2 class="display-lg">More number system guides</h2>
        </div>
        <div class="related-grid">
          {related.map((item) => (
            <a class="related-card card shadow-level-2" href={guideHref(item.slug)}>
              <span class="related-label">{item.shortLabel}</span>
              <span class="related-summary">{item.summary}</span>
              <span class="related-more">Read guide →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .crumbs {
    border-bottom: 1px solid var(--color-hairline);
  }

  .crumbs-inner {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
    padding-block: var(--spacing-sm);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-mute);
  }

  .crumbs-inner a {
    color: var(--color-body);
    text-decoration: none;
  }

  .crumbs-inner a:hover {
    color: var(--color-ink);
  }

  .crumbs-inner [aria-current='page'] {
    color: var(--color-ink);
  }

  .guide-hero {
    padding-block: var(--spacing-4xl) var(--spacing-3xl);
    border-bottom: 1px solid var(--color-hairline);
    background-color: var(--color-canvas-soft);
  }

  .guide-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: var(--spacing-3xl);
    align-items: start;
  }

  .guide-title {
    font-size: 44px;
    line-height: 1.08;
    letter-spacing: -1.8px;
    font-weight: 600;
    color: var(--color-ink);
    margin: var(--spacing-sm) 0 var(--spacing-md);
    max-width: 18ch;
  }

  .guide-lead {
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
    max-width: 62ch;
    margin: 0;
  }

  .guide-answer {
    margin-top: var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-link-bg-soft);
    border-left: 3px solid var(--color-link);
    border-radius: var(--radius-sm);
    max-width: 68ch;
  }

  .guide-answer-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-mute);
    margin-bottom: 2px;
  }

  .guide-answer p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-ink);
  }

  .guide-meta a {
    color: var(--color-body);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .guide-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-md);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-mute);
  }

  .meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-hairline-strong);
  }

  .guide-cta {
    background: var(--color-canvas);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    position: sticky;
    top: 88px;
  }

  .cta-copy {
    font-size: 14px;
    line-height: 21px;
    color: var(--color-body);
    margin: var(--spacing-xs) 0 var(--spacing-md);
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 38px;
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-canvas);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
  }

  .cta-btn:hover {
    opacity: 0.85;
    color: var(--color-canvas);
  }

  .cta-link {
    display: block;
    margin-top: var(--spacing-sm);
    text-align: center;
    font-size: 12px;
  }

  .guide-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--spacing-3xl);
    padding-block: var(--spacing-4xl);
    align-items: start;
  }

  .toc {
    position: sticky;
    top: 88px;
    border-left: 1px solid var(--color-hairline);
    padding-left: var(--spacing-md);
  }

  .toc-heading {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-mute);
    margin-bottom: var(--spacing-sm);
  }

  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
  }

  .toc-list a {
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-body);
    text-decoration: none;
  }

  .toc-list a:hover {
    color: var(--color-ink);
  }

  .guide-body {
    max-width: 760px;
    min-width: 0;
    color: var(--color-body);
    font-size: 16px;
    line-height: 1.7;
  }

  .guide-body :global(h2) {
    font-size: 28px;
    line-height: 1.25;
    letter-spacing: -1px;
    font-weight: 600;
    color: var(--color-ink);
    margin: var(--spacing-4xl) 0 var(--spacing-sm);
    scroll-margin-top: 88px;
  }

  .guide-body :global(h2:first-child) {
    margin-top: 0;
  }

  .guide-body :global(h3) {
    font-size: 19px;
    line-height: 1.35;
    letter-spacing: -0.4px;
    font-weight: 600;
    color: var(--color-ink);
    margin: var(--spacing-2xl) 0 var(--spacing-xs);
    scroll-margin-top: 88px;
  }

  .guide-body :global(p) {
    margin: 0 0 var(--spacing-md);
  }

  .guide-body :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .guide-body :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .guide-body :global(ul),
  .guide-body :global(ol) {
    margin: 0 0 var(--spacing-md);
    padding-left: var(--spacing-lg);
  }

  .guide-body :global(li) {
    margin-bottom: 6px;
  }

  .guide-body :global(li::marker) {
    color: var(--color-mute);
  }

  .guide-body :global(code) {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
    padding: 1px 5px;
    color: var(--color-ink);
    word-break: break-word;
  }

  .guide-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin-block: var(--spacing-lg);
    display: block;
    overflow-x: auto;
  }

  .guide-body :global(thead th) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-align: left;
    color: var(--color-mute);
    padding: var(--spacing-xs) var(--spacing-sm);
    border-bottom: 1px solid var(--color-hairline);
    white-space: nowrap;
  }

  .guide-body :global(td) {
    padding: var(--spacing-xs) var(--spacing-sm);
    border-bottom: 1px solid var(--color-hairline);
  }

  .guide-body :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  .guide-body :global(.answer-box) {
    background: var(--color-link-bg-soft);
    border-radius: var(--radius-md);
    padding: var(--spacing-md) var(--spacing-lg);
    margin-block: var(--spacing-lg);
  }

  .guide-body :global(.answer-box p:last-child) {
    margin-bottom: 0;
  }

  .guide-body :global(.note) {
    border-left: 3px solid var(--color-link);
    padding: var(--spacing-xs) 0 var(--spacing-xs) var(--spacing-md);
    margin-block: var(--spacing-lg);
    color: var(--color-body);
    font-size: 15px;
  }

  .guide-sources {
    margin-top: var(--spacing-3xl);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-hairline);
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-mute);
  }

  .guide-sources strong {
    color: var(--color-ink);
  }

  .guide-faq {
    border-top: 1px solid var(--color-hairline);
    padding-block: var(--spacing-4xl);
  }

  .faq-head {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-2xl);
  }

  .faq-head h2 {
    margin: 0;
    color: var(--color-ink);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-md);
  }

  .faq-block {
    background: var(--color-canvas);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
  }

  .faq-block h3 {
    font-size: 16px;
    line-height: 1.35;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 var(--spacing-xs);
  }

  .faq-block :global(p) {
    font-size: 14px;
    line-height: 22px;
    color: var(--color-body);
    margin: 0;
  }

  .faq-block :global(strong) {
    color: var(--color-ink);
  }

  .guide-related {
    border-top: 1px solid var(--color-hairline);
    padding-block: var(--spacing-4xl);
  }

  .related-head {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-2xl);
  }

  .related-head h2 {
    margin: 0;
    color: var(--color-ink);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--spacing-md);
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    background: var(--color-canvas);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease;
  }

  .related-card:hover {
    transform: translateY(-2px);
    color: inherit;
  }

  .related-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-mute);
  }

  .related-summary {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .related-more {
    margin-top: auto;
    padding-top: var(--spacing-sm);
    font-size: 13px;
    color: var(--color-link);
  }

  @media (max-width: 1000px) {
    .guide-hero-inner {
      grid-template-columns: 1fr;
    }

    .guide-cta {
      position: static;
      max-width: 360px;
    }

    .guide-shell {
      grid-template-columns: minmax(0, 1fr);
      padding-block: var(--spacing-3xl);
    }

    .toc {
      position: static;
      border-left: none;
      border-top: 1px solid var(--color-hairline);
      padding: var(--spacing-md) 0 0;
    }

    .toc-list {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }

  @media (max-width: 600px) {
    .guide-title {
      font-size: 32px;
      letter-spacing: -1.2px;
    }

    .guide-lead {
      font-size: 16px;
      line-height: 25px;
    }

    .guide-body :global(h2) {
      font-size: 23px;
    }
  }
</style>
