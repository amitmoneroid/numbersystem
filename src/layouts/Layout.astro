---
//
// Layout.astro — SEO/GEO layout shell with entity, page, breadcrumb,
// FAQ and web-app structured data.
//
import ConsentBanner from '../components/ConsentBanner.astro';

interface Crumb {
  name: string;
  url: string;
}

interface FaqSchemaItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  keywords?: string;
  ogType?: string;
  ogImage?: string;
  /** Robots directive. Use "noindex, follow" for error pages. */
  robots?: string;
  /** Render the WebApplication node (tool pages). */
  includeAppSchema?: boolean;
  /** Visible Q&A pairs to mirror in FAQPage schema. */
  faqItems?: FaqSchemaItem[];
  breadcrumbs?: Crumb[];
  datePublished?: string;
  dateModified?: string;
}

const {
  title = 'Number System Converter – Bases 2–36 & Lakh/Crore',
  description = 'Free number system converter with steps for binary, octal, decimal, hex and base 2–36, plus lakh, crore, million and billion. Tables, solutions and PDF.',
  canonicalURL = 'https://numbersystemconverter.com/',
  keywords = 'number system converter with steps, number system converter online, number system conversion calculator with solution, number system conversion pdf, base converter calculator, number system conversion table, number system converter, lakh to million, crore to billion',
  ogType = 'website',
  ogImage,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  includeAppSchema = false,
  faqItems = [],
  breadcrumbs = [],
  datePublished = '2026-07-27',
  dateModified = '2026-11-01',
} = Astro.props;

const siteName = 'NumSys';
const organizationId = 'https://numbersystemconverter.com/#organization';
const websiteId = 'https://numbersystemconverter.com/#website';
const pageId = `${canonicalURL}#webpage`;
const imageURL = ogImage ?? new URL('/og-image.png', canonicalURL).href;

const stripHtml = (html: string) =>
  html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': organizationId,
    name: 'NumSys',
    alternateName: ['Number System Converter', 'NumSys Converter'],
    url: 'https://numbersystemconverter.com/',
    // Profiles that officially represent the publisher (Spaarc Digital, the
    // parent organization). Replace/extend with NumSys-specific profiles once
    // dedicated accounts exist — only list live accounts the brand controls.
    sameAs: [
      'https://www.instagram.com/spaarcdigital',
      'https://www.linkedin.com/company/spaarcdigital',
      'https://x.com/spaarcdigital',
      'https://www.youtube.com/@spaarcdigital',
    ],
    logo: {
      '@type': 'ImageObject',
      url: 'https://numbersystemconverter.com/web-app-manifest-512x512.png',
      width: 512,
      height: 512,
    },
    description:
      'NumSys publishes free browser-based number system and base conversion tools with step-by-step worked solutions.',
    publishingPrinciples: 'https://numbersystemconverter.com/about/#method',
    correctionsPolicy: 'https://numbersystemconverter.com/about/#method',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      url: 'https://numbersystemconverter.com/contact/',
      availableLanguage: ['en'],
    },
    knowsAbout: [
      'Number system conversion',
      'Binary, octal, decimal and hexadecimal',
      'Indian numbering system (lakh, crore, arab)',
      'International short scale (million, billion, trillion)',
      'Base 2 to base 36 conversion',
    ],
    parentOrganization: {
      '@type': 'Organization',
      name: 'Spaarc Digital',
      url: 'https://www.spaarcdigital.com/',
    },
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: 'https://numbersystemconverter.com/',
    name: siteName,
    publisher: { '@id': organizationId },
    inLanguage: 'en',
  },
  {
    '@type': 'WebPage',
    '@id': pageId,
    url: canonicalURL,
    name: title,
    description,
    isPartOf: { '@id': websiteId },
    about: { '@id': organizationId },
    inLanguage: 'en',
    datePublished,
    dateModified,
  },
];

if (includeAppSchema) {
  graph.push({
    '@type': 'WebApplication',
    '@id': `${canonicalURL}#app`,
    name: 'Number System Converter',
    url: canonicalURL,
    description,
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    image: imageURL,
    featureList: [
      'Convert Indian number system to International format',
      'Convert International number system to Indian format',
      'Base 2 to base 36 conversion with steps',
      'Binary, octal, decimal and hex shown side by side',
      'Shareable conversion links (?v=156&from=10&to=2)',
      'Full word expansion in both systems',
      'Side-by-side comparison',
      'Breakdown table showing scale mapping',
    ],
    creator: { '@id': organizationId },
    publisher: { '@id': organizationId },
  });
}

if (breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalURL}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.name,
      item: crumb.url,
    })),
  });
}

if (faqItems.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonicalURL}#faq`,
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(item.answer),
      },
    })),
  });
}
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Number System Converter" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="dark light" />
		<meta name="theme-color" content="#0a0a0a" />

		<!-- Dark mode is the default; only an explicit user choice switches to light. -->
		<script is:inline>
			(function() {
				try {
					if (localStorage.getItem('theme') === 'light') {
						document.documentElement.classList.remove('dark');
						document.documentElement.classList.add('light');
					} else {
						document.documentElement.classList.add('dark');
						document.documentElement.classList.remove('light');
					}
				} catch (e) {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>

		<!-- Google Analytics is loaded by ConsentBanner.astro only after the
		     visitor opts in; see /privacy-policy/. -->

		<!-- Primary SEO Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content={robots} />
		<meta name="author" content="NumSys Editorial Team" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook Meta Tags -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="NumSys number system converter — binary, octal, decimal, hex plus lakh, crore, million and billion" />

		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />
		<meta name="twitter:image:alt" content="NumSys number system converter" />

		<!-- Per-page head content (e.g. structured data) -->
		<slot name="head" />

		<!-- Schema.org Structured Data: entity graph + page + optional app/breadcrumb/FAQ -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@graph': graph,
		})} />

		<!-- Self-hosted fonts (latin subsets). Preloaded so first paint can use
		     them, with font-display: optional to prevent late swaps. -->
		<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
		<ConsentBanner />
		<script is:inline>
			// Offline support: the converter and every page you have visited keep
			// working after the network drops. Skipped in local dev.
			if (
				'serviceWorker' in navigator &&
				location.hostname !== 'localhost' &&
				location.hostname !== '127.0.0.1'
			) {
				window.addEventListener('load', function () {
					navigator.serviceWorker.register('/sw.js').catch(function () {});
				});
			}
		</script>
	</body>
</html>

<style is:global>
	@import "../styles/global.css";
</style>
