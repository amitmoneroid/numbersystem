---
//
// Layout.astro — SEO/GEO layout shell with entity, page, breadcrumb,
// FAQ and web-app structured data.
//
interface Crumb {
  name: string;
  url: string;
}

interface FaqSchemaItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  keywords?: string;
  ogType?: string;
  ogImage?: string;
  /** Render the WebApplication node (tool pages). */
  includeAppSchema?: boolean;
  /** Visible Q&A pairs to mirror in FAQPage schema. */
  faqItems?: FaqSchemaItem[];
  breadcrumbs?: Crumb[];
  datePublished?: string;
  dateModified?: string;
}

const {
  title = 'Number System Converter – Bases 2–36 & Lakh/Crore',
  description = 'Free number system converter with steps for binary, octal, decimal, hex and base 2–36, plus lakh, crore, million and billion. Tables, solutions and PDF.',
  canonicalURL = 'https://numbersystemconverter.com/',
  keywords = 'number system converter with steps, number system converter online, number system conversion calculator with solution, number system conversion pdf, base converter calculator, number system conversion table, number system converter, lakh to million, crore to billion',
  ogType = 'website',
  ogImage,
  includeAppSchema = false,
  faqItems = [],
  breadcrumbs = [],
  datePublished = '2026-07-27',
  dateModified = '2026-10-27',
} = Astro.props;

const siteName = 'NumSys';
const organizationId = 'https://numbersystemconverter.com/#organization';
const websiteId = 'https://numbersystemconverter.com/#website';
const pageId = `${canonicalURL}#webpage`;
const imageURL = ogImage ?? new URL('/og-image.png', canonicalURL).href;

const stripHtml = (html: string) =>
  html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': organizationId,
    name: 'NumSys',
    alternateName: ['Number System Converter', 'NumSys Converter'],
    url: 'https://numbersystemconverter.com/',
    // Profiles that officially represent the publisher (Spaarc Digital, the
    // parent organization). Replace/extend with NumSys-specific profiles once
    // dedicated accounts exist — only list live accounts the brand controls.
    sameAs: [
      'https://www.instagram.com/spaarcdigital',
      'https://www.linkedin.com/company/spaarcdigital',
      'https://x.com/spaarcdigital',
      'https://www.youtube.com/@spaarcdigital',
    ],
    logo: {
      '@type': 'ImageObject',
      url: 'https://numbersystemconverter.com/web-app-manifest-512x512.png',
      width: 512,
      height: 512,
    },
    description:
      'NumSys publishes free browser-based number system and base conversion tools with step-by-step worked solutions.',
    knowsAbout: [
      'Number system conversion',
      'Binary, octal, decimal and hexadecimal',
      'Indian numbering system (lakh, crore, arab)',
      'International short scale (million, billion, trillion)',
      'Base 2 to base 36 conversion',
    ],
    parentOrganization: {
      '@type': 'Organization',
      name: 'Spaarc Digital',
      url: 'https://www.spaarcdigital.com/',
    },
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: 'https://numbersystemconverter.com/',
    name: siteName,
    publisher: { '@id': organizationId },
    inLanguage: 'en',
  },
  {
    '@type': 'WebPage',
    '@id': pageId,
    url: canonicalURL,
    name: title,
    description,
    isPartOf: { '@id': websiteId },
    about: { '@id': organizationId },
    inLanguage: 'en',
    datePublished,
    dateModified,
  },
];

if (includeAppSchema) {
  graph.push({
    '@type': 'WebApplication',
    '@id': `${canonicalURL}#app`,
    name: 'Number System Converter',
    url: canonicalURL,
    description,
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: [
      'Convert Indian number system to International format',
      'Convert International number system to Indian format',
      'Base 2 to base 36 conversion with steps',
      'Binary, octal, decimal and hex shown side by side',
      'Shareable conversion links (?v=156&from=10&to=2)',
      'Full word expansion in both systems',
      'Side-by-side comparison',
      'Breakdown table showing scale mapping',
    ],
    creator: { '@id': organizationId },
    publisher: { '@id': organizationId },
  });
}

if (breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalURL}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.name,
      item: crumb.url,
    })),
  });
}

if (faqItems.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonicalURL}#faq`,
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(item.answer),
      },
    })),
  });
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Number System Converter" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<!-- Prevent FOUC: set dark class before paint -->
		<script is:inline>
			(function() {
				const stored = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (stored === 'dark' || (!stored && prefersDark) || stored === null) {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>

		<!-- Google Analytics (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-3E6Y8CWECC"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-3E6Y8CWECC');
		</script>

		<!-- Primary SEO Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="author" content="NumSys Editorial Team" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook Meta Tags -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="NumSys number system converter — binary, octal, decimal, hex plus lakh, crore, million and billion" />

		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />
		<meta name="twitter:image:alt" content="NumSys number system converter" />

		<!-- Per-page head content (e.g. structured data) -->
		<slot name="head" />

		<!-- Schema.org Structured Data: entity graph + page + optional app/breadcrumb/FAQ -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@graph': graph,
		})} />

		<!-- Google Fonts: Inter (Geist substitute) + JetBrains Mono (Geist Mono substitute).
		     Loaded asynchronously so the font CSS does not block first paint. -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"></noscript>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	@import "../styles/global.css";
</style>
