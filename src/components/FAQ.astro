---
// FAQ.astro — visible FAQ section. Content comes from src/data/faq.ts so the
// rendered answers and the FAQPage schema in Layout.astro cannot drift apart.
import { faqItems } from '../data/faq';

interface Props {
  items?: typeof faqItems;
  heading?: string;
  intro?: string;
}

const {
  items = faqItems,
  heading = 'Number system conversion questions, answered',
  intro = 'Short, direct answers about lakh and crore, million and billion, binary and hex, and the numbers people search for most.',
} = Astro.props;
---

<section id="faq" class="faq-band band-canvas-soft section-band">
  <div class="page-container">
    <div class="section-header">
      <span class="eyebrow">FAQ</span>
      <h2 class="display-lg">{heading}</h2>
      <p class="body-md faq-intro">{intro}</p>
    </div>

    <div class="faq-list">
      {items.map((item) => (
        <details class="faq-item card shadow-level-2">
          <summary class="faq-question">
            <h3 class="faq-question-text">{item.question}</h3>
            <span class="faq-toggle" aria-hidden="true"></span>
          </summary>
          <div class="faq-answer" set:html={item.answer} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .section-band {
    padding-block: var(--spacing-5xl);
  }

  .section-header {
    max-width: 720px;
    margin-bottom: var(--spacing-3xl);
  }

  .section-header h2 {
    margin: var(--spacing-xs) 0 var(--spacing-sm);
    color: var(--color-ink);
  }

  .faq-intro {
    color: var(--color-body);
    margin: 0;
  }

  .faq-list {
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .faq-item {
    background: var(--color-canvas);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow 0.15s ease;
  }

  .faq-item:hover {
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.1),
      0px 2px 2px rgba(0, 0, 0, 0.04),
      0px 8px 8px -8px rgba(0, 0, 0, 0.04);
  }

  .dark .faq-item:hover {
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0px 2px 2px rgba(0, 0, 0, 0.4),
      0px 8px 8px -8px rgba(0, 0, 0, 0.5);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question-text {
    font-size: 17px;
    font-weight: 600;
    line-height: 26px;
    color: var(--color-ink);
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .faq-toggle {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .faq-toggle::before,
  .faq-toggle::after {
    content: '';
    position: absolute;
    background: var(--color-mute);
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .faq-toggle::before {
    width: 12px;
    height: 2px;
  }

  .faq-toggle::after {
    width: 2px;
    height: 12px;
  }

  .faq-item[open] .faq-toggle::after {
    transform: rotate(90deg);
    opacity: 0;
  }

  .faq-item[open] .faq-toggle {
    background: var(--color-link-bg-soft);
    border-color: var(--color-link);
  }

  .faq-item[open] .faq-toggle::before {
    background: var(--color-link);
  }

  .faq-item[open] .faq-question {
    border-bottom: 1px solid var(--color-hairline);
  }

  .faq-answer {
    padding: var(--spacing-lg);
  }

  .faq-answer :global(p) {
    color: var(--color-body);
    font-size: 15px;
    line-height: 24px;
    margin: 0 0 var(--spacing-sm);
  }

  .faq-answer :global(p:last-child),
  .faq-answer :global(ol:last-child),
  .faq-answer :global(ul:last-child) {
    margin-bottom: 0;
  }

  .faq-answer :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .faq-answer :global(ol),
  .faq-answer :global(ul) {
    margin: 0 0 var(--spacing-sm);
    padding-left: var(--spacing-lg);
    color: var(--color-body);
    font-size: 15px;
    line-height: 24px;
  }

  @media (max-width: 600px) {
    .faq-question-text {
      font-size: 16px;
      line-height: 24px;
    }

    .faq-question,
    .faq-answer {
      padding: var(--spacing-md);
    }
  }
</style>
