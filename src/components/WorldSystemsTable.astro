---
// WorldSystemsTable.astro — benchmark table for 16 numbering systems.
import { worldSystems } from '../data/worldSystems';

interface Props {
  caption?: string;
}
const { caption = 'How 16 numbering systems name 1 million, 1 billion and 1 trillion, benchmarked against the International short scale.' } = Astro.props;
---

<div class="world-table-wrap card shadow-level-2">
  <div class="world-table-scroll">
    <table class="world-table">
      <caption>{caption}</caption>
      <thead>
        <tr>
          <th scope="col">System</th>
          <th scope="col">10⁶</th>
          <th scope="col">10⁹</th>
          <th scope="col">10¹²</th>
          <th scope="col">Vs International</th>
        </tr>
      </thead>
      <tbody>
        {worldSystems.map((system) => (
          <tr>
            <th scope="row">
              <span class="system-name">{system.name}</span>
              <span class="system-region">{system.region}</span>
              <span class={`scale-tag scale-${system.scale}`}>{system.scale === 'myriad' ? '4-digit grouping' : `${system.scale} scale`}</span>
            </th>
            <td>{system.tenToSix}</td>
            <td>{system.tenToNine}</td>
            <td>{system.tenToTwelve}</td>
            <td class="benchmark-cell">{system.benchmark}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .world-table-wrap {
    background: var(--color-canvas);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-block: var(--spacing-2xl);
    max-width: 100%;
    min-width: 0;
  }

  .world-table-scroll {
    overflow-x: auto;
    max-width: 100%;
  }

  .world-table {
    width: 100%;
    min-width: 860px;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }

  .world-table caption {
    caption-side: top;
    text-align: left;
    padding: var(--spacing-md) var(--spacing-lg);
    font-size: 13px;
    color: var(--color-mute);
    border-bottom: 1px solid var(--color-hairline);
  }

  .world-table thead th {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-mute);
    padding: var(--spacing-sm) var(--spacing-md);
    border-bottom: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft);
    position: sticky;
    top: 0;
  }

  .world-table tbody th {
    padding: var(--spacing-sm) var(--spacing-md);
    border-bottom: 1px solid var(--color-hairline);
    font-weight: 500;
    color: var(--color-ink);
    vertical-align: top;
    text-align: left;
    min-width: 190px;
  }

  .world-table td {
    padding: var(--spacing-sm) var(--spacing-md);
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-body);
    vertical-align: top;
  }

  .world-table tbody tr:last-child th,
  .world-table tbody tr:last-child td {
    border-bottom: none;
  }

  .world-table tbody tr:hover td,
  .world-table tbody tr:hover th {
    background: var(--color-canvas-soft);
  }

  .system-name {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .system-region {
    display: block;
    font-size: 11px;
    line-height: 1.4;
    color: var(--color-mute);
    margin-top: 2px;
  }

  .scale-tag {
    display: inline-block;
    margin-top: 6px;
    padding: 1px 6px;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid var(--color-hairline);
    color: var(--color-mute);
  }

  .scale-short {
    color: var(--color-link);
    border-color: color-mix(in srgb, var(--color-link) 35%, transparent);
  }

  .scale-long {
    color: var(--color-violet);
    border-color: color-mix(in srgb, var(--color-violet) 35%, transparent);
  }

  .scale-myriad {
    color: var(--color-highlight-magenta);
    border-color: color-mix(in srgb, var(--color-highlight-magenta) 35%, transparent);
  }

  .scale-indian {
    color: var(--color-cyan);
    border-color: color-mix(in srgb, var(--color-cyan) 45%, transparent);
  }

  .benchmark-cell {
    font-size: 13px;
    line-height: 1.5;
    min-width: 260px;
  }
</style>
