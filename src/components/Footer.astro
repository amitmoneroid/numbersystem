---
// Footer.astro — Vercel-style footer with site navigation and language links.
import {
  canonicalPath,
  defaultLocale,
  isLocale,
  localeMeta,
  locales,
  localizePath,
  translatedPaths,
} from '../i18n/routing';
import { footerUi } from '../i18n/ui';

interface Props {
  /** Current page locale. Defaults to English. */
  locale?: string;
}

const locale = isLocale(Astro.props.locale) ? Astro.props.locale : defaultLocale;
const t = footerUi[locale];
const languageOptions = locales.map((code) => ({
  code,
  meta: localeMeta[code],
  href: localizePath('/', code),
  current: code === locale,
}));
// Only offer locale links where a translated version of this page exists.
const showLanguages = translatedPaths.has(canonicalPath(Astro.url.pathname));
---

<footer class="footer">
  <div class="page-container footer-inner">
    <div class="footer-left">
      <a href={locale === defaultLocale ? '/' : `/${locale}/`} class="footer-logo">
        <span class="logo-mark-sm"></span>
        <span>NumSys</span>
      </a>
      <p class="footer-pitch">{t.pitch}</p>
    </div>
    <div class="footer-nav">
      <div class="footer-nav-col">
        <h3 class="footer-nav-heading">{t.learnHeading}</h3>
        <ul class="footer-nav-list">
          {t.learnLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-nav-col">
        <h3 class="footer-nav-heading">{t.pagesHeading}</h3>
        <ul class="footer-nav-list">
          {t.pageLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-nav-col">
        <h3 class="footer-nav-heading">{t.legalHeading}</h3>
        <ul class="footer-nav-list">
          {t.legalLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
          <li><button type="button" class="footer-link-btn" data-consent-reset>{t.analytics}</button></li>
        </ul>
      </div>
      {showLanguages && (
        <div class="footer-nav-col">
          <h3 class="footer-nav-heading">{t.languagesHeading}</h3>
          <ul class="footer-nav-list">
            {languageOptions.map((option) => (
              <li>
                <a
                  href={option.href}
                  hreflang={option.meta.htmlLang}
                  lang={option.meta.htmlLang}
                  aria-current={option.current ? 'page' : undefined}
                  class:list={{ current: option.current }}
                >{option.meta.nativeName}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
  <div class="page-container footer-bottom">
    <p class="footer-copy">{t.copyright} &nbsp;·&nbsp; {t.lastUpdated} <time datetime="2026-11-06">6 November 2026</time></p>
    <p class="footer-powered">
      {t.poweredBy} <a href="https://www.spaarcdigital.com/" target="_blank" rel="noopener noreferrer">Spaarc Digital</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
    padding: var(--spacing-4xl) var(--spacing-lg) 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--spacing-2xl);
    padding-bottom: var(--spacing-3xl);
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    max-width: 300px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: -0.56px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .logo-mark-sm {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: linear-gradient(135deg, var(--color-gradient-develop-start), var(--color-gradient-preview-end));
  }

  .footer-pitch {
    font-size: 14px;
    color: var(--color-mute);
    line-height: 20px;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4xl);
  }

  .footer-nav-col {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .footer-nav-heading {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-mute);
    margin: 0;
  }

  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .footer-nav-list a {
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link-btn {
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: var(--color-body);
    text-align: left;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .footer-link-btn:hover {
    color: var(--color-ink);
  }

  .footer-nav-list a:hover {
    color: var(--color-ink);
  }

  .footer-nav-list a.current {
    color: var(--color-ink);
    font-weight: 600;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-hairline);
    padding: var(--spacing-lg) 0;
  }

  .footer-copy {
    font-size: 12px;
    color: var(--color-mute);
    font-family: var(--font-mono);
    line-height: 16px;
    margin: 0;
  }

  .footer-powered {
    font-size: 12px;
    color: var(--color-mute);
    font-family: var(--font-mono);
    line-height: 16px;
    margin: 0;
    margin-top: var(--spacing-xxs);
  }

  .footer-powered a {
    color: var(--color-body);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }

  .footer-powered a:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  @media (max-width: 600px) {
    .footer {
      padding: var(--spacing-3xl) var(--spacing-md) 0;
    }

    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-nav {
      gap: var(--spacing-2xl);
    }
  }
</style>