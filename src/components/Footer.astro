---
// Footer.astro — Minimal Vercel-style footer
---

<footer class="footer">
  <div class="page-container footer-inner">
    <div class="footer-left">
      <a href="/" class="footer-logo">
        <span class="logo-mark-sm"></span>
        <span>NumSys</span>
      </a>
      <p class="footer-pitch">A clear, fast number system converter built with clarity in mind.</p>
    </div>
    <p class="footer-copy">&copy; 2026 NumSys Converter. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
    padding: var(--spacing-4xl) var(--spacing-lg) var(--spacing-lg);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: -0.56px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .logo-mark-sm {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: linear-gradient(135deg, var(--color-gradient-develop-start), var(--color-gradient-preview-end));
  }

  .footer-pitch {
    font-size: 14px;
    color: var(--color-mute);
    line-height: 20px;
    max-width: 380px;
  }

  .footer-copy {
    font-size: 12px;
    color: var(--color-mute);
    font-family: var(--font-mono);
    line-height: 16px;
  }

  @media (max-width: 600px) {
    .footer {
      padding: var(--spacing-3xl) var(--spacing-md) var(--spacing-lg);
    }

    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
