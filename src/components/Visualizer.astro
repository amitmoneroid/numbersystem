---
// Visualizer.astro
---

<section id="visualizer" class="visualizer-section">
  <div class="section-header">
    <span class="eyebrow">Smart Preview Tech</span>
    <h2>1:1 Scale Brand Visualizer</h2>
    <p>
      At SPAARC, we don't just send flat PDFs. Calibrate your screen using one of the three methods below to preview your new website layout and physical branding assets in <strong>exact 1:1 real-world size</strong>.
    </p>
  </div>

  <div class="visualizer-container">
    <!-- Left Panel: Calibration Wizard -->
    <div class="card calibration-card">
      <div class="card-header">
        <h3>1. Calibrate Your Screen</h3>
        <div class="status-indicator" id="calibrationStatus">
          <span class="status-dot"></span>
          <span class="status-text">Default (96 PPI)</span>
        </div>
      </div>

      <!-- Calibration Method Selector -->
      <div class="tabs-container">
        <button class="tab-btn active" data-tab="detect">Auto-Detect</button>
        <button class="tab-btn" data-tab="diagonal">Screen Diagonal</button>
        <button class="tab-btn" data-tab="creditcard">Credit Card</button>
      </div>

      <!-- Tab Content Area -->
      <div class="tab-content-wrapper">
        <!-- Method 1: Auto-Detect -->
        <div class="tab-content active" id="tab-detect">
          <p class="tab-description">
            We will estimate your screen's Pixels Per Inch (PPI) based on your system resolution and device type.
          </p>
          <div class="info-grid">
            <div class="info-item">
              <span class="label">Screen Resolution</span>
              <span class="value" id="detectResolution">Loading...</span>
            </div>
            <div class="info-item">
              <span class="label">Device Pixel Ratio</span>
              <span class="value" id="detectDpr">Loading...</span>
            </div>
            <div class="info-item">
              <span class="label">Estimated Screen Type</span>
              <span class="value" id="detectType">Loading...</span>
            </div>
          </div>
          <button class="btn btn-primary w-full" id="btnAutoDetect">
            Estimate PPI
          </button>
          <div class="info-msg">
            Note: OS display scaling may affect auto-detection. Use other methods for absolute physical precision.
          </div>
        </div>

        <!-- Method 2: Screen Diagonal -->
        <div class="tab-content" id="tab-diagonal">
          <p class="tab-description">
            Enter the diagonal size of your screen in inches to calculate exact PPI based on your aspect ratio.
          </p>
          <div class="input-group">
            <label for="diagonalInput">Diagonal Screen Size (Inches)</label>
            <div class="input-wrapper">
              <input type="number" id="diagonalInput" value="15.6" min="5" max="100" step="0.1" />
              <span class="input-suffix">in</span>
            </div>
          </div>
          <div class="quick-selects">
            <span class="quick-label">Common Sizes:</span>
            <button class="btn-chip" data-size="13.3">MacBook 13.3"</button>
            <button class="btn-chip" data-size="15.6">Laptop 15.6"</button>
            <button class="btn-chip" data-size="24">Monitor 24"</button>
            <button class="btn-chip" data-size="27">Monitor 27"</button>
          </div>
          <button class="btn btn-primary w-full" id="btnApplyDiagonal">
            Calculate PPI
          </button>
        </div>

        <!-- Method 3: Credit Card Calibration -->
        <div class="tab-content" id="tab-creditcard">
          <p class="tab-description">
            Place a physical credit/debit card (standard 85.6 mm / 3.37" width) on your screen and adjust the slider until the digital card matches your physical card.
          </p>
          
          <!-- Interactive Credit Card Slider Target -->
          <div class="card-slider-target-container">
            <div class="cc-outline" id="ccOutline">
              <div class="cc-inner">
                <span class="cc-chip"></span>
                <span class="cc-brand">CARD SIZE PREVIEW</span>
                <span class="cc-hint">Place physical card here</span>
              </div>
            </div>
          </div>

          <div class="slider-group">
            <div class="slider-label-row">
              <span>Card Width (Pixels)</span>
              <span id="ccPixelsVal">323px</span>
            </div>
            <input type="range" id="ccSlider" min="200" max="600" value="323" />
          </div>

          <button class="btn btn-primary w-full" id="btnConfirmCc">
            Confirm & Save PPI
          </button>
        </div>
      </div>

      <!-- Real-time Ruler Scale feedback -->
      <div class="ruler-preview">
        <span class="ruler-label">1 Inch Physical Calibration Reference:</span>
        <div class="ruler-bar-container">
          <div class="ruler-bar" id="rulerBar"></div>
          <span class="ruler-tick">0</span>
          <span class="ruler-tick" style="left: 100%">1"</span>
        </div>
        <div class="ppi-readout">
          Current PPI: <strong id="ppiReadoutVal">96.0</strong> px/inch
        </div>
      </div>
    </div>

    <!-- Right Panel: 1:1 Scale Real-World Mockup Previews -->
    <div class="card preview-card">
      <div class="card-header">
        <h3>2. 1:1 Physical Scale Mockups</h3>
        <div class="preview-toggles">
          <button class="preview-toggle-btn active" data-mockup="card">Business Card</button>
          <button class="preview-toggle-btn" data-mockup="mobile">Mobile Site</button>
          <button class="preview-toggle-btn" data-mockup="flyer">A5 Menu/Flyer</button>
        </div>
      </div>

      <!-- Preview Canvas -->
      <div class="preview-canvas">
        
        <!-- Mockup 1: Business Card -->
        <div class="mockup-container active" id="mockup-card">
          <div class="physical-card-shell" id="cardShell">
            <div class="card-spark-glow"></div>
            <div class="card-front">
              <div class="card-header-logo">
                <span class="card-logo-symbol"></span>
                <span class="card-logo-text">SPAARC</span>
              </div>
              <div class="card-meta">
                <p class="card-name">Devendra Sharma</p>
                <p class="card-title">Co-Founder & Tech Lead</p>
              </div>
              <div class="card-contact">
                <p>⚡ info@spaarcdigital.com</p>
                <p>📍 Mumbai • Bangalore • Delhi</p>
                <p>🌐 spaarcdigital.com</p>
              </div>
            </div>
          </div>
          <p class="canvas-hint">Standard Indian Business Card size: 3.5" × 2.0" (88.9 × 50.8 mm)</p>
        </div>

        <!-- Mockup 2: Mobile Website Screen -->
        <div class="mockup-container" id="mockup-mobile">
          <div class="physical-phone-shell" id="phoneShell">
            <div class="phone-camera-notch"></div>
            <div class="phone-screen">
              <!-- Live Mockup of a website designed by SPAARC -->
              <div class="phone-web-header">
                <span class="phone-web-logo">🌶️ Mumbai Spice</span>
                <span class="phone-web-menu">☰</span>
              </div>
              <div class="phone-web-hero">
                <h1>Authentic Mumbai Flavors</h1>
                <p>Order fresh Vada Pav & Biryani online.</p>
                <a href="javascript:void(0)" class="phone-web-btn">View Menu</a>
              </div>
              <div class="phone-web-features">
                <div class="phone-feature-card">
                  <h4>🚀 10 Min Delivery</h4>
                  <p>Hot food delivered right to your doorstep across Dadar.</p>
                </div>
                <div class="phone-feature-card">
                  <h4>⭐ 4.9 Rated</h4>
                  <p>Loved by over 5000+ local foodies.</p>
                </div>
              </div>
              <div class="phone-web-footer">
                © 2026 Mumbai Spice Bistro. Built by SPAARC.
              </div>
            </div>
          </div>
          <p class="canvas-hint">Estimated Smartphone Display width: 2.82" (71.6 mm)</p>
        </div>

        <!-- Mockup 3: A5 Menu/Flyer -->
        <div class="mockup-container" id="mockup-flyer">
          <div class="physical-flyer-shell" id="flyerShell">
            <div class="flyer-content">
              <div class="flyer-header">
                <span class="flyer-tag">SPAARC ACADEMY PRESENTS</span>
                <h1>Local Business Growth</h1>
                <p class="flyer-subtitle">Setup Your Digital Profile & Branding Today</p>
              </div>
              <div class="flyer-body">
                <div class="flyer-highlight">
                  <h3>₹4,999 / mo</h3>
                  <p>Full Website + Local SEO Listing</p>
                </div>
                <ul>
                  <li>⚡ Professional 5-Page Site</li>
                  <li>📍 Google Map Setup & Optimization</li>
                  <li>📱 Social Media Creative Kits</li>
                  <li>💬 WhatsApp Business Integration</li>
                </ul>
              </div>
              <div class="flyer-footer">
                <p>Call Us: +91 98765 43210</p>
                <p>Scan to get free brand audit</p>
              </div>
            </div>
          </div>
          <p class="canvas-hint">Standard A5 Marketing Flyer: 5.83" × 8.27" (148 × 210 mm)</p>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  // State variables
  let ppi = 96.0;

  // DOM Elements - Calibration
  const calibrationStatusText = document.querySelector('#calibrationStatus .status-text');
  const ppiReadoutVal = document.getElementById('ppiReadoutVal');
  const rulerBar = document.getElementById('rulerBar');
  const ccOutline = document.getElementById('ccOutline');
  const ccSlider = document.getElementById('ccSlider') as HTMLInputElement;
  const ccPixelsVal = document.getElementById('ccPixelsVal');
  const diagonalInput = document.getElementById('diagonalInput') as HTMLInputElement;

  // DOM Elements - Previews
  const cardShell = document.getElementById('cardShell');
  const phoneShell = document.getElementById('phoneShell');
  const flyerShell = document.getElementById('flyerShell');

  // DOM Elements - Tabs / Navigation
  const tabButtons = document.querySelectorAll('.tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');
  const previewToggleBtns = document.querySelectorAll('.preview-toggle-btn');
  const mockupContainers = document.querySelectorAll('.mockup-container');

  // Auto-Detect Elements
  const detectResolution = document.getElementById('detectResolution');
  const detectDpr = document.getElementById('detectDpr');
  const detectType = document.getElementById('detectType');

  // Initialize display details for Auto-Detect Tab
  if (detectResolution) detectResolution.textContent = `${window.screen.width} × ${window.screen.height}`;
  if (detectDpr) detectDpr.textContent = `${window.devicePixelRatio}`;
  if (detectType) {
    const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    const isTablet = (isMobile && window.screen.width >= 768) || (navigator.userAgent.includes('Macintosh') && 'ontouchend' in document);
    detectType.textContent = isTablet ? 'Tablet / iPad' : isMobile ? 'Smartphone' : 'Laptop / Desktop Monitor';
  }

  // Update PPI across all elements
  function updatePPI(newPpi: number, methodLabel: string) {
    ppi = Math.round(newPpi * 10) / 10; // Round to 1 decimal
    
    // Update Readouts
    if (ppiReadoutVal) ppiReadoutVal.textContent = ppi.toFixed(1);
    if (calibrationStatusText) {
      calibrationStatusText.textContent = `${methodLabel} (${ppi} PPI)`;
      const dot = document.querySelector('#calibrationStatus .status-dot');
      dot?.classList.add('calibrated');
    }

    // 1. Update 1" physical ruler bar CSS width
    if (rulerBar) {
      rulerBar.style.width = `${ppi}px`;
    }

    // 2. Scale Mockup 1: Business Card (3.5" x 2.0")
    if (cardShell) {
      cardShell.style.width = `${3.5 * ppi}px`;
      cardShell.style.height = `${2.0 * ppi}px`;
    }

    // 3. Scale Mockup 2: Smartphone frame (Width: ~2.82" based on standard physical sizing)
    if (phoneShell) {
      phoneShell.style.width = `${2.82 * ppi}px`;
      phoneShell.style.height = `${5.81 * ppi}px`;
    }

    // 4. Scale Mockup 3: A5 Menu/Flyer (5.83" x 8.27")
    if (flyerShell) {
      flyerShell.style.width = `${5.83 * ppi}px`;
      flyerShell.style.height = `${8.27 * ppi}px`;
    }
  }

  // Calibration Method 1: Auto-Detect
  function performAutoDetect() {
    let estPpi = 96.0;
    const width = window.screen.width;
    const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    
    if (isMobile) {
      if (width >= 768) {
        estPpi = 264.0; // Typical iPad / Tablet
      } else {
        estPpi = 400.0; // Typical modern mobile screen density
      }
    } else {
      // Laptop/Desktops
      if (window.devicePixelRatio > 1.5) {
        estPpi = 220.0; // Retina Laptop display
      } else {
        // Standard monitors: 1080p 24" matches ~92 PPI. Standard windows density is 96 PPI.
        estPpi = width >= 2560 ? 109.0 : 96.0;
      }
    }
    updatePPI(estPpi, 'Auto-Detected');
  }

  document.getElementById('btnAutoDetect')?.addEventListener('click', performAutoDetect);

  // Calibration Method 2: Screen Diagonal
  document.getElementById('btnApplyDiagonal')?.addEventListener('click', () => {
    const diagonal = parseFloat(diagonalInput.value);
    if (!isNaN(diagonal) && diagonal > 0) {
      const w = window.screen.width;
      const h = window.screen.height;
      const pixelDiagonal = Math.sqrt(w * w + h * h);
      const calculatedPpi = pixelDiagonal / diagonal;
      updatePPI(calculatedPpi, 'Manual Diagonal');
    }
  });

  // Diagonal quick select chips
  document.querySelectorAll('.btn-chip').forEach(chip => {
    chip.addEventListener('click', (e) => {
      const size = (e.currentTarget as HTMLButtonElement).dataset.size;
      if (size && diagonalInput) {
        diagonalInput.value = size;
        // Trigger calc
        const w = window.screen.width;
        const h = window.screen.height;
        const pixelDiagonal = Math.sqrt(w * w + h * h);
        const calculatedPpi = pixelDiagonal / parseFloat(size);
        updatePPI(calculatedPpi, 'Manual Diagonal');
      }
    });
  });

  // Calibration Method 3: Credit Card Calibration
  ccSlider?.addEventListener('input', () => {
    const val = ccSlider.value;
    if (ccPixelsVal) ccPixelsVal.textContent = `${val}px`;
    if (ccOutline) ccOutline.style.width = `${val}px`;
    
    // Credit card standard physical width: 3.37 inches
    // PPI = Slider Pixel Width / 3.37
    const calculatedPpi = parseInt(val) / 3.3700787;
    
    // Update ruler and readout immediately, but don't apply fully to mockups until confirmed
    if (ppiReadoutVal) ppiReadoutVal.textContent = calculatedPpi.toFixed(1);
    if (rulerBar) rulerBar.style.width = `${calculatedPpi}px`;
  });

  document.getElementById('btnConfirmCc')?.addEventListener('click', () => {
    const val = parseInt(ccSlider.value);
    const calculatedPpi = val / 3.3700787;
    updatePPI(calculatedPpi, 'Card Calibrated');
  });

  // Handle Calibration Tabs
  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      tabButtons.forEach(b => b.classList.remove('active'));
      tabContents.forEach(c => c.classList.remove('active'));
      
      btn.classList.add('active');
      const tabId = btn.getAttribute('data-tab');
      const targetContent = document.getElementById(`tab-${tabId}`);
      if (targetContent) targetContent.classList.add('active');

      // Adjust credit card width initial layout if entering credit card tab
      if (tabId === 'creditcard' && ccSlider && ccOutline) {
        ccOutline.style.width = `${ccSlider.value}px`;
      }
    });
  });

  // Handle Mockup Toggles
  previewToggleBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      previewToggleBtns.forEach(b => b.classList.remove('active'));
      mockupContainers.forEach(c => c.classList.remove('active'));

      btn.classList.add('active');
      const mockId = btn.getAttribute('data-mockup');
      const targetMockup = document.getElementById(`mockup-${mockId}`);
      if (targetMockup) targetMockup.classList.add('active');
    });
  });

  // Trigger initial auto estimation on mount
  performAutoDetect();
</script>

<style>
  .visualizer-section {
    padding: 96px 24px;
    background: radial-gradient(circle at 80% 90%, rgba(0, 242, 254, 0.05) 0%, rgba(0, 0, 0, 0) 40%);
    border-bottom: 1px solid var(--border-color);
  }

  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 56px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--accent-cyan);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 12px;
  }

  .section-header h2 {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 16px;
    background: linear-gradient(180deg, #ffffff 0%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-header p {
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  .visualizer-container {
    max-width: var(--page-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1.3fr;
    gap: 40px;
    align-items: stretch;
  }

  .card {
    background: rgba(15, 16, 22, 0.4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 32px;
    display: flex;
    flex-direction: column;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .card-header h3 {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.04);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-color);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--text-muted);
  }

  .status-dot.calibrated {
    background-color: var(--accent-cyan);
    box-shadow: 0 0 8px var(--accent-cyan);
  }

  .status-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Tabs Navigation */
  .tabs-container {
    display: flex;
    background: rgba(0, 0, 0, 0.2);
    border-radius: var(--radius-sm);
    padding: 4px;
    margin-bottom: 24px;
    border: 1px solid var(--border-color);
  }

  .tab-btn {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 8px 0;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    color: var(--text-primary);
  }

  .tab-btn.active {
    background: var(--bg-surface-elevated);
    color: var(--accent-cyan);
    box-shadow: var(--shadow-sm);
  }

  /* Tab contents */
  .tab-content-wrapper {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    min-height: 250px;
  }

  .tab-content {
    display: none;
    flex-direction: column;
    height: 100%;
  }

  .tab-content.active {
    display: flex;
  }

  .tab-description {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 24px;
  }

  .info-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    padding: 12px 8px;
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .info-item .label {
    display: block;
    font-size: 0.65rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .info-item .value {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .btn {
    border: none;
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-primary {
    background: var(--text-primary);
    color: var(--bg-primary);
  }

  .btn-primary:hover {
    background: var(--accent-cyan);
    box-shadow: 0 0 15px rgba(0, 242, 254, 0.3);
  }

  .w-full {
    width: 100%;
  }

  .info-msg {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 12px;
    text-align: center;
  }

  /* Diagonal Input styles */
  .input-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }

  .input-group label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-wrapper input {
    width: 100%;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--border-color);
    padding: 12px 40px 12px 16px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    border-radius: var(--radius-sm);
    outline: none;
  }

  .input-wrapper input:focus {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 10px rgba(0, 242, 254, 0.1);
  }

  .input-suffix {
    position: absolute;
    right: 16px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .quick-selects {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .quick-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .btn-chip {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 4px 10px;
    font-size: 0.75rem;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-chip:hover {
    background: rgba(0, 242, 254, 0.1);
    color: var(--accent-cyan);
    border-color: rgba(0, 242, 254, 0.3);
  }

  /* Credit Card calibration helper styles */
  .card-slider-target-container {
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(0, 0, 0, 0.3);
    border-radius: var(--radius-sm);
    height: 180px;
    margin-bottom: 20px;
    border: 1px dashed var(--border-color);
    overflow: hidden;
  }

  .cc-outline {
    width: 323px; /* standard 3.37 inches * 96 ppi */
    height: calc(323px / 1.585); /* standard aspect ratio of bank card 1.585 */
    border: 2px solid var(--accent-cyan);
    box-shadow: 0 0 15px rgba(0, 242, 254, 0.3);
    border-radius: 12px;
    padding: 6px;
    transition: width 0.1s ease, height 0.1s ease;
  }

  .cc-inner {
    width: 100%;
    height: 100%;
    border: 1px solid rgba(0, 242, 254, 0.2);
    border-radius: 8px;
