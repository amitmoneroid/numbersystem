# Canonical URL rules for numbersystemconverter.com
#
# Canonicals are the apex domain with a trailing slash. Cloudflare `_redirects`
# rules can only match a path (domain-level matching is not supported), so the
# `www` -> apex redirect is handled in functions/_middleware.js.
#
# These rules catch legacy slash-less links that point at real pages. They are
# kept relative so the same file works for both Cloudflare Pages and Workers
# static assets.

/about /about/ 301
/contact /contact/ 301
/privacy-policy /privacy-policy/ 301
/terms /terms/ 301
/knowledge-catalog /knowledge-catalog/ 301
/knowledge-catalog/number-system-converter-with-steps /knowledge-catalog/number-system-converter-with-steps/ 301
/knowledge-catalog/number-system-converter-online /knowledge-catalog/number-system-converter-online/ 301
/knowledge-catalog/number-system-conversion-calculator-with-solution /knowledge-catalog/number-system-conversion-calculator-with-solution/ 301
/knowledge-catalog/number-system-conversion-pdf /knowledge-catalog/number-system-conversion-pdf/ 301
/knowledge-catalog/base-converter-calculator /knowledge-catalog/base-converter-calculator/ 301
/knowledge-catalog/number-system-conversion-table /knowledge-catalog/number-system-conversion-table/ 301
